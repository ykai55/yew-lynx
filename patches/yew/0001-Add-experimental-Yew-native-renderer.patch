+        type Properties = ();
+
+        fn create(_ctx: &Context<Self>) -> Self {
+            Self
+        }
+
+        fn view(&self, _ctx: &Context<Self>) -> Html {
+            html! { <view ontap={|_: NativeEvent| {}}><text>{"mounted"}</text></view> }
+        }
+
+        fn destroy(&mut self, _ctx: &Context<Self>) {
+            panic!("destroy lifecycle panic")
+        }
+    }
+
+    struct ReentrantRender;
+
+    impl Component for ReentrantRender {
+        type Message = ();
+        type Properties = ();
+
