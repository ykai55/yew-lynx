+/// A native-renderer `tap` event listener.
+#[cfg(feature = "native_renderer")]
+pub mod ontap {
+    use std::rc::Rc;
+
+    use crate::NativeEvent;
+    use crate::callback::Callback;
+    use crate::virtual_dom::{Listener, ListenerKind};
+
+    /// A wrapper for a native-renderer tap callback.
+    #[derive(Clone, Debug)]
+    pub struct Wrapper {
+        callback: Callback<NativeEvent>,
+    }
+
+    impl Wrapper {
+        /// Creates a native-renderer tap callback wrapper.
+        pub fn new(callback: Callback<NativeEvent>) -> Self {
+            Self { callback }
+        }
+
+        #[doc(hidden)]
+        pub fn __macro_new(
+            callback: impl crate::html::IntoEventCallback<NativeEvent>,
+        ) -> Option<Rc<dyn Listener>> {
+            Some(Rc::new(Self::new(callback.into_event_callback()?)))
+        }
+    }
+
+    /// The event passed to a native-renderer tap callback.
+    pub type Event = NativeEvent;
+
+    impl Listener for Wrapper {
+        fn kind(&self) -> ListenerKind {
+            ListenerKind::ontap
+        }
+
+        fn handle(&self, _event: web_sys::Event) {
+            unreachable!("native-renderer events cannot be dispatched by the browser DOM renderer")
+        }
+
+        fn passive(&self) -> bool {
+            false
+        }
+
+        fn handle_native_renderer(&self, event: NativeEvent) {
+            self.callback.emit(event);
+        }
+    }
+}
