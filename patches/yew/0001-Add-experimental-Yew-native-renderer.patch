+extern crate self as yew;
+
+use yew_macro::html;
+
+// Trybuild does not preserve features requested on dev-dependencies. Provide
+// the minimal expansion surface needed to verify that `ontap` is a listener.
+pub struct NativeEvent;
+
+pub mod html {
+    pub use crate::virtual_dom::NodeRef;
+
+    pub mod ontap {
+        pub struct Wrapper;
+
+        impl Wrapper {
+            pub fn __macro_new(_callback: impl Fn(crate::NativeEvent) + 'static) -> Option<()> {
+                Some(())
+            }
+        }
+    }
+}
+
+pub mod virtual_dom {
+    pub enum AttrValue {
+        Static(&'static str),
+    }
+
+    pub enum AttributeOrProperty {}
+
+    pub struct Attributes;
+
+    impl Attributes {
+        pub fn from_static_unchecked(_values: &[(&'static str, AttributeOrProperty)]) -> Self {
+            Self
+        }
+    }
+
+    pub struct Key;
+
+    #[derive(Default)]
+    pub struct NodeRef;
+
+    impl NodeRef {
+        pub fn __native_renderer_unbound() -> Self {
+            Self
+        }
+    }
+
+    #[derive(Default)]
+    pub struct VNode;
+
+    pub struct VTag;
+
+    impl VTag {
+        pub fn __new_other(
+            _tag: AttrValue,
+            _node_ref: NodeRef,
+            _key: Option<Key>,
+            _attributes: Attributes,
+            _listeners: listeners::Listeners,
+            _children: VNode,
+        ) -> Self {
+            Self
+        }
+    }
+
+    impl From<VTag> for VNode {
+        fn from(_tag: VTag) -> Self {
+            Self
+        }
+    }
+
+    pub mod listeners {
+        pub enum Listeners {
+            None,
+            Pending(Box<[Option<()>]>),
+        }
+    }
+}
+
+fn main() {
+    _ = html! { <view ontap={|_: NativeEvent| {}} /> };
+}
