diff --git a/packages/yew/src/native_bundle.rs b/packages/yew/src/native_bundle.rs
new file mode 100644
index 0000000..e75c107
--- /dev/null
+++ b/packages/yew/src/native_bundle.rs
@@ -0,0 +1,286 @@
+use std::collections::BTreeMap;
+use std::rc::Rc;
+
+use crate::native_renderer::{NativeEvent, NativeListener, NativeNode, NativeRendererBackend};
+use crate::virtual_dom::{Listeners, VNode, VTag};
+
+pub(crate) struct NativeBundle {
+    vnode: Option<VNode>,
+    kind: NativeBundleKind,
+}
+
+enum NativeBundleKind {
+    Empty,
+    Node {
+        node: NativeNode,
+        children: Vec<NativeBundle>,
+        listeners: Vec<NativeListener>,
+    },
+    List(Vec<NativeBundle>),
+}
+
+struct PendingChildren<'a> {
+    backend: &'a Rc<dyn NativeRendererBackend>,
+    parent: NativeNode,
+    children: Vec<NativeBundle>,
+}
+
+impl PendingChildren<'_> {
+    fn finish(mut self) -> Vec<NativeBundle> {
+        std::mem::take(&mut self.children)
+    }
+}
+
+impl Drop for PendingChildren<'_> {
+    fn drop(&mut self) {
+        for child in std::mem::take(&mut self.children) {
+            child.detach(self.backend, self.parent);
+        }
+    }
+}
+
+struct PendingNode<'a> {
+    backend: &'a Rc<dyn NativeRendererBackend>,
+    parent: NativeNode,
+    node: Option<NativeNode>,
+    inserted: bool,
+    children: Vec<NativeBundle>,
+    listeners: Vec<NativeListener>,
+}
+
+impl PendingNode<'_> {
+    fn finish(mut self) -> NativeBundleKind {
+        NativeBundleKind::Node {
+            node: self
+                .node
+                .take()
+                .expect("pending native-renderer node is missing"),
+            children: std::mem::take(&mut self.children),
+            listeners: std::mem::take(&mut self.listeners),
+        }
+    }
+}
+
+impl Drop for PendingNode<'_> {
+    fn drop(&mut self) {
+        let Some(node) = self.node.take() else {
+            return;
+        };
+        if self.inserted {
+            self.backend.remove(self.parent, node);
+        }
+        for listener in std::mem::take(&mut self.listeners) {
+            self.backend.remove_event_listener(node, listener);
+        }
+        for child in std::mem::take(&mut self.children) {
+            child.detach(self.backend, node);
+        }
+        self.backend.destroy_node(node);
+    }
+}
+
+impl std::fmt::Debug for NativeBundle {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("NativeBundle").finish_non_exhaustive()
+    }
+}
+
+impl NativeBundle {
+    pub(crate) const fn new() -> Self {
+        Self {
+            vnode: None,
+            kind: NativeBundleKind::Empty,
+        }
+    }
+
+    pub(crate) fn reconcile(
+        &mut self,
+        backend: &Rc<dyn NativeRendererBackend>,
+        parent: NativeNode,
+        vnode: VNode,
+    ) {
+        Self::validate(&vnode);
+        if self.vnode.as_ref() == Some(&vnode) {
+            return;
+        }
+
+        let reference = self.first_node();
+        let next = Self::attach(backend, parent, reference, vnode);
+        let previous = std::mem::replace(self, next);
+        previous.detach(backend, parent);
+    }
+
+    pub(crate) fn detach(self, backend: &Rc<dyn NativeRendererBackend>, parent: NativeNode) {
+        match self.kind {
+            NativeBundleKind::Empty => {}
+            NativeBundleKind::List(children) => {
+                for child in children {
+                    child.detach(backend, parent);
+                }
+            }
+            NativeBundleKind::Node {
+                node,
+                children,
+                listeners,
+            } => {
+                backend.remove(parent, node);
+                for listener in listeners {
+                    backend.remove_event_listener(node, listener);
+                }
+                for child in children {
+                    child.detach(backend, node);
+                }
+                backend.destroy_node(node);
+            }
+        }
+    }
+
+    fn first_node(&self) -> Option<NativeNode> {
+        match &self.kind {
+            NativeBundleKind::Empty => None,
+            NativeBundleKind::Node { node, .. } => Some(*node),
+            NativeBundleKind::List(children) => children.iter().find_map(Self::first_node),
+        }
+    }
+
+    fn validate(vnode: &VNode) {
+        if vnode.key().is_some() {
+            panic!("keyed VNodes are not supported by the native renderer")
+        }
+
+        match vnode {
+            VNode::VText(_) => {}
+            VNode::VTag(tag) => {
+                if tag.node_ref.is_native_renderer_binding() {
+                    panic!("NodeRef bindings are not supported by the native renderer")
+                }
+                if let Listeners::Pending(listeners) = &tag.listeners {
+                    for listener in listeners.iter().flatten() {
+                        let name = listener.kind().type_name();
+                        if name.as_ref() != "tap" {
+                            panic!("event `{name}` is not supported by the native renderer")
+                        }
+                    }
+                }
+                if let Some(children) = tag.children() {
+                    Self::validate(children);
+                }
+            }
+            VNode::VList(list) => {
+                for child in list.iter() {
+                    Self::validate(child);
+                }
+            }
+            VNode::VComp(_) => {
+                panic!("nested Yew components are not supported by the native renderer yet")
+            }
+            VNode::VRef(_) => panic!("VRef is specific to the browser DOM"),
+            VNode::VPortal(_) => panic!("portals are not supported by the native renderer"),
+            VNode::VSuspense(_) => panic!("Suspense is not supported by the native renderer"),
+            VNode::VRaw(_) => panic!("raw HTML cannot be rendered by the native renderer"),
+        }
+    }
+
+    fn attach(
+        backend: &Rc<dyn NativeRendererBackend>,
+        parent: NativeNode,
+        reference: Option<NativeNode>,
+        vnode: VNode,
+    ) -> Self {
+        let kind = match &vnode {
+            VNode::VText(text) => {
+                let node = backend.create_text(&text.text);
+                let mut pending = PendingNode {
+                    backend,
+                    parent,
+                    node: Some(node),
+                    inserted: false,
+                    children: Vec::new(),
+                    listeners: Vec::new(),
+                };
+                backend.insert_before(parent, node, reference);
+                pending.inserted = true;
+                pending.finish()
+            }
+            VNode::VTag(tag) => Self::attach_tag(backend, parent, reference, tag),
+            VNode::VList(list) => {
+                let mut pending = PendingChildren {
+                    backend,
+                    parent,
+                    children: Vec::with_capacity(list.len()),
+                };
+                for child in list.iter() {
+                    pending
+                        .children
+                        .push(Self::attach(backend, parent, reference, child.clone()));
+                }
+                NativeBundleKind::List(pending.finish())
+            }
+            VNode::VComp(_) => {
+                unreachable!("native-renderer VNode validation rejected nested components")
+            }
+            VNode::VRef(_) => panic!("VRef is specific to the browser DOM"),
+            VNode::VPortal(_) => panic!("portals are not supported by the native renderer"),
+            VNode::VSuspense(_) => panic!("Suspense is not supported by the native renderer"),
+            VNode::VRaw(_) => panic!("raw HTML cannot be rendered by the native renderer"),
+        };
+
+        Self {
+            vnode: Some(vnode),
+            kind,
+        }
+    }
+
+    fn attach_tag(
+        backend: &Rc<dyn NativeRendererBackend>,
+        parent: NativeNode,
+        reference: Option<NativeNode>,
+        tag: &VTag,
+    ) -> NativeBundleKind {
+        let node = backend.create_element(tag.tag());
+        let mut pending = PendingNode {
+            backend,
+            parent,
+            node: Some(node),
+            inserted: false,
+            children: Vec::new(),
+            listeners: Vec::new(),
+        };
+        let attributes: BTreeMap<&str, &str> = tag.attributes.iter().collect();
+        for (name, value) in attributes {
+            backend.set_attribute(node, name, Some(value));
+        }
+        if let Some(value) = tag.value() {
+            backend.set_attribute(node, "value", Some(value));
+        }
+        if let Some(checked) = tag.checked() {
+            backend.set_attribute(node, "checked", checked.then_some("true"));
+        }
+
+        if let Listeners::Pending(listeners) = &tag.listeners {
+            for listener in listeners.iter().flatten() {
+                let listener = Rc::clone(listener);
+                let name = listener.kind().type_name();
+                let name = match name.as_ref() {
+                    "tap" => "tap",
+                    name => panic!("event `{name}` is not supported by the native renderer"),
+                };
+                pending.listeners.push(backend.add_event_listener(
+                    node,
+                    name,
+                    Box::new(move |event: NativeEvent| listener.handle_native_renderer(event)),
+                ));
+            }
+        }
+
+        backend.insert_before(parent, node, reference);
+        pending.inserted = true;
+        if let Some(children) = tag.children() {
+            pending
+                .children
+                .push(Self::attach(backend, node, None, children.clone()));
+        }
+
+        pending.finish()
+    }
+}
diff --git a/packages/yew/src/native_renderer.rs b/packages/yew/src/native_renderer.rs
new file mode 100644
index 0000000..ac41aa2
--- /dev/null
+++ b/packages/yew/src/native_renderer.rs
@@ -0,0 +1,868 @@
+use std::fmt;
+use std::ops::Deref;
+use std::panic::{AssertUnwindSafe, catch_unwind, resume_unwind};
+use std::rc::Rc;
+
+use crate::html::{BaseComponent, Scope};
+use crate::native_bundle::NativeBundle;
+
+/// An opaque node owned by a [`NativeRendererBackend`].
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub struct NativeNode(pub u64);
+
+/// An opaque event-listener registration owned by a [`NativeRendererBackend`].
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub struct NativeListener(pub u64);
+
+/// The event value delivered by the experimental native renderer.
+///
+/// The first prototype intentionally carries only the event name. Event detail
+/// can be added without changing Yew's component or reconciliation API.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct NativeEvent {
+    name: Rc<str>,
+}
+
+impl NativeEvent {
+    /// Creates a backend event with a host event name.
+    pub fn new(name: impl Into<Rc<str>>) -> Self {
+        Self { name: name.into() }
+    }
+
+    /// Returns the host event name.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+}
+
+/// Node operations required by Yew's experimental native renderer.
+///
+/// A backend is responsible for forwarding these operations to a concrete
+/// element tree. All methods are called synchronously on the thread that owns
+/// the renderer, and implementations must neither move callbacks to another
+/// thread nor call any backend method from another thread.
+///
+/// Backend methods must not panic. In particular, teardown can run while a
+/// component panic is unwinding, when a second panic would abort the process.
+/// After [`NativeRendererBackend::remove_event_listener`] returns, the callback associated
+/// with that listener must be disconnected and released, and the backend must
+/// never invoke it again. A registered callback may be invoked only on the
+/// renderer's owner thread.
+///
+/// Each created node is initially detached. Insertion gives it one direct
+/// parent, removal makes it detached again, and destruction receives a detached
+/// node whose listeners and direct children have already been removed. The
+/// renderer applies that sequence recursively and never destroys the root node
+/// supplied to [`NativeRenderer`].
+pub trait NativeRendererBackend: fmt::Debug + 'static {
+    /// Creates a container element.
+    fn create_element(&self, tag: &str) -> NativeNode;
+
+    /// Creates a text-content node.
+    fn create_text(&self, text: &str) -> NativeNode;
+
+    /// Inserts detached `child` before a direct child `reference`, or appends it
+    /// when no reference is provided.
+    fn insert_before(&self, parent: NativeNode, child: NativeNode, reference: Option<NativeNode>);
+
+    /// Detaches the direct `child` from `parent` without destroying it.
+    fn remove(&self, parent: NativeNode, child: NativeNode);
+
+    /// Releases a detached node with no listeners or direct children.
+    fn destroy_node(&self, node: NativeNode);
+
+    /// Sets or clears an element attribute.
+    fn set_attribute(&self, node: NativeNode, name: &str, value: Option<&str>);
+
+    /// Registers an event listener.
+    fn add_event_listener(
+        &self,
+        node: NativeNode,
+        name: &str,
+        callback: Box<dyn Fn(NativeEvent)>,
+    ) -> NativeListener;
+
+    /// Synchronously removes an event listener and releases its callback.
+    fn remove_event_listener(&self, node: NativeNode, listener: NativeListener);
+
+    /// Flushes pending element mutations into the host render pipeline.
+    fn flush(&self, root: NativeNode);
+}
+
+/// A mounted Yew application backed by a native renderer.
+#[derive(Debug)]
+pub struct NativeAppHandle<COMP: BaseComponent> {
+    pub(crate) scope: Scope<COMP>,
+}
+
+/// Returned when an application cannot be destroyed from the current scheduler callback.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct NativeRendererBusy;
+
+impl fmt::Display for NativeRendererBusy {
+    fn fmt(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("a native renderer cannot be destroyed from a Yew scheduler callback")
+    }
+}
+
+impl std::error::Error for NativeRendererBusy {}
+
+impl<COMP: BaseComponent> NativeAppHandle<COMP> {
+    /// Synchronously destroys the application on its owner thread.
+    ///
+    /// If the component's destroy lifecycle panics with unwind enabled, the
+    /// Native renderer tree and listeners are still removed before the panic resumes.
+    /// When called from a running Yew scheduler callback, this returns
+    /// [`NativeRendererBusy`] without queueing teardown or invalidating the handle.
+    pub fn destroy(&mut self) -> Result<(), NativeRendererBusy> {
+        if crate::scheduler::is_running() {
+            return Err(NativeRendererBusy);
+        }
+        self.scope.clone().destroy_native_renderer();
+        Ok(())
+    }
+
+    /// Releases renderer-owned Rust state without mutating the host tree.
+    ///
+    /// This is an emergency teardown path for a host whose owner thread or
+    /// element tree is already gone. Normal integrations must call [`Self::destroy`]
+    /// so nodes and listeners are removed from the host.
+    pub fn abandon(&mut self) {
+        self.scope.clone().abandon_native_renderer();
+    }
+}
+
+impl<COMP: BaseComponent> Deref for NativeAppHandle<COMP> {
+    type Target = Scope<COMP>;
+
+    fn deref(&self) -> &Self::Target {
+        &self.scope
+    }
+}
+
+/// Renders a Yew component tree into a [`NativeRendererBackend`] on a native target.
+#[derive(Debug)]
+#[must_use = "NativeRenderer does nothing unless render() is called."]
+pub struct NativeRenderer<COMP: BaseComponent> {
+    backend: Rc<dyn NativeRendererBackend>,
+    root: NativeNode,
+    props: COMP::Properties,
+}
+
+impl<COMP> NativeRenderer<COMP>
+where
+    COMP: BaseComponent<Properties: Default>,
+{
+    /// Creates a renderer with default component properties.
+    pub fn new(backend: Rc<dyn NativeRendererBackend>, root: NativeNode) -> Self {
+        Self::with_props(backend, root, Default::default())
+    }
+}
+
+impl<COMP> NativeRenderer<COMP>
+where
+    COMP: BaseComponent,
+{
+    /// Creates a renderer with explicit component properties.
+    pub fn with_props(
+        backend: Rc<dyn NativeRendererBackend>,
+        root: NativeNode,
+        props: COMP::Properties,
+    ) -> Self {
+        Self {
+            backend,
+            root,
+            props,
+        }
+    }
+
+    /// Mounts the component and synchronously commits its first native renderer tree.
+    ///
+    /// Unsupported output panics before host mutation. Cleanup of a later panic
+    /// requires `panic = "unwind"`; aborting panics cannot run cleanup guards.
+    pub fn render(self) -> NativeAppHandle<COMP> {
+        assert!(
+            !crate::scheduler::is_running(),
+            "NativeRenderer::render cannot run from a Yew scheduler callback"
+        );
+        let app = NativeAppHandle {
+            scope: Scope::new(None),
+        };
+        let mounted = catch_unwind(AssertUnwindSafe(|| {
+            app.scope
+                .mount_in_native_renderer(self.backend, self.root, Rc::new(self.props));
+        }));
+        if let Err(payload) = mounted {
+            app.scope.clone().destroy_native_renderer();
+            resume_unwind(payload);
+        }
+        app
+    }
+}
+
+pub(crate) fn empty_bundle() -> NativeBundle {
+    NativeBundle::new()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::cell::{Cell, RefCell};
+    use std::collections::{BTreeMap, HashMap};
+    use std::fmt::Write as _;
