+    impl NativeRendererBackend for MockBackend {
+        fn create_element(&self, tag: &str) -> NativeNode {
+            self.create_node(tag, None)
+        }
+
+        fn create_text(&self, text: &str) -> NativeNode {
+            self.create_node("text", Some(text))
+        }
+
+        fn insert_before(
+            &self,
+            parent: NativeNode,
+            child: NativeNode,
+            reference: Option<NativeNode>,
+        ) {
+            {
+                let nodes = self.nodes.borrow();
+                assert!(nodes.contains_key(&parent));
+                assert_eq!(nodes.get(&child).unwrap().parent, None);
+                if let Some(reference) = reference {
+                    assert_eq!(nodes.get(&reference).unwrap().parent, Some(parent));
+                }
+            }
+            let mut nodes = self.nodes.borrow_mut();
+            let children = &mut nodes.get_mut(&parent).unwrap().children;
+            let index = reference.map_or(children.len(), |reference| {
+                children
+                    .iter()
+                    .position(|candidate| *candidate == reference)
+                    .unwrap()
+            });
+            children.insert(index, child);
+            nodes.get_mut(&child).unwrap().parent = Some(parent);
+        }
+
+        fn remove(&self, parent: NativeNode, child: NativeNode) {
+            let mut nodes = self.nodes.borrow_mut();
+            assert_eq!(nodes.get(&child).unwrap().parent, Some(parent));
+            let children = &mut nodes.get_mut(&parent).unwrap().children;
+            let index = children
+                .iter()
+                .position(|candidate| *candidate == child)
+                .unwrap();
+            children.remove(index);
+            nodes.get_mut(&child).unwrap().parent = None;
+        }
+
+        fn destroy_node(&self, node: NativeNode) {
+            assert!(
+                self.listeners
+                    .borrow()
+                    .values()
+                    .all(|listener| listener.node != node)
+            );
+            let mut nodes = self.nodes.borrow_mut();
+            let state = nodes.get(&node).unwrap();
+            assert_eq!(state.parent, None);
+            assert!(state.children.is_empty());
+            nodes.remove(&node).unwrap();
+        }
+
+        fn set_attribute(&self, node: NativeNode, name: &str, value: Option<&str>) {
+            let mut nodes = self.nodes.borrow_mut();
+            let attributes = &mut nodes.get_mut(&node).unwrap().attributes;
+            match value {
+                Some(value) => {
+                    attributes.insert(name.into(), value.into());
+                }
+                None => {
+                    attributes.remove(name);
+                }
+            }
+        }
+
+        fn add_event_listener(
+            &self,
+            node: NativeNode,
+            name: &str,
+            callback: Box<dyn Fn(NativeEvent)>,
+        ) -> NativeListener {
+            let listener = NativeListener(self.next_listener.get());
+            self.next_listener.set(listener.0 + 1);
+            self.listeners.borrow_mut().insert(
+                listener,
+                ListenerState {
+                    node,
+                    name: name.into(),
+                    callback: Rc::from(callback),
+                },
+            );
+            listener
+        }
+
+        fn remove_event_listener(&self, node: NativeNode, listener: NativeListener) {
+            let removed = self.listeners.borrow_mut().remove(&listener).unwrap();
+            assert_eq!(node, removed.node);
+        }
+
+        fn flush(&self, _root: NativeNode) {
+            self.flushes.set(self.flushes.get() + 1);
+        }
+    }
