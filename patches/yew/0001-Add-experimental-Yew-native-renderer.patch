+#[cfg(feature = "native_renderer")]
+mod feat_native_renderer {
+    use super::*;
+    use crate::html::component::lifecycle::{
+        ComponentRenderState, CreateRunner, DestroyRunner, RenderRunner,
+    };
+    use crate::native_renderer::{NativeNode, NativeRendererBackend, empty_bundle};
+    use crate::scheduler;
+
+    impl<COMP: BaseComponent> Scope<COMP> {
+        pub(crate) fn mount_in_native_renderer(
+            &self,
+            backend: Rc<dyn NativeRendererBackend>,
+            root: NativeNode,
+            props: Rc<COMP::Properties>,
+        ) {
+            let state = ComponentRenderState::NativeRenderer {
+                bundle: empty_bundle(),
+                backend,
+                root,
+                parent: root,
+            };
+            scheduler::push_component_create(
+                self.id,
+                Box::new(CreateRunner {
+                    initial_render_state: state,
+                    props,
+                    scope: self.clone(),
+                    #[cfg(feature = "hydration")]
+                    prepared_state: None,
+                }),
+                Box::new(RenderRunner {
+                    state: self.state.clone(),
+                }),
+            );
+            scheduler::start();
+        }
+
+        pub(crate) fn destroy_native_renderer(self) {
+            scheduler::push_component_destroy(Box::new(DestroyRunner {
+                state: self.state,
+                parent_to_detach: false,
+            }));
+            scheduler::start();
+        }
+
+        pub(crate) fn abandon_native_renderer(self) {
+            let state = self.state.borrow_mut().take();
+            drop(state);
+        }
+    }
+}
