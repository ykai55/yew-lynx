+                format!("<{tag}{attributes}>{children}</{tag}>", tag = state.tag)
+            }
+            render(&nodes, node)
+        }
+
+        fn tap(&self) {
+            let callback = self
+                .listeners
+                .borrow()
+                .values()
+                .find(|listener| listener.name == "tap")
+                .map(|listener| Rc::clone(&listener.callback))
+                .expect("tap listener not found");
+            callback(NativeEvent::new("tap"));
+        }
+    }
