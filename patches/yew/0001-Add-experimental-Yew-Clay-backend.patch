+/// A Clay `tap` event listener.
+#[cfg(feature = "clay")]
+pub mod ontap {
+    use std::rc::Rc;
+
+    use crate::ClayEvent;
+    use crate::callback::Callback;
+    use crate::virtual_dom::{Listener, ListenerKind};
+
+    /// A wrapper for a Clay tap callback.
+    #[derive(Clone, Debug)]
+    pub struct Wrapper {
+        callback: Callback<ClayEvent>,
+    }
+
+    impl Wrapper {
+        /// Creates a Clay tap callback wrapper.
+        pub fn new(callback: Callback<ClayEvent>) -> Self {
+            Self { callback }
+        }
+
+        #[doc(hidden)]
+        pub fn __macro_new(
+            callback: impl crate::html::IntoEventCallback<ClayEvent>,
+        ) -> Option<Rc<dyn Listener>> {
+            Some(Rc::new(Self::new(callback.into_event_callback()?)))
+        }
+    }
+
+    /// The event passed to a Clay tap callback.
+    pub type Event = ClayEvent;
+
+    impl Listener for Wrapper {
+        fn kind(&self) -> ListenerKind {
+            ListenerKind::ontap
+        }
+
+        fn handle(&self, _event: web_sys::Event) {
+            unreachable!("Clay events cannot be dispatched by the browser DOM renderer")
+        }
+
+        fn passive(&self) -> bool {
+            false
+        }
+
+        fn handle_clay(&self, event: ClayEvent) {
+            self.callback.emit(event);
+        }
+    }
+}
