+        type Properties = ();
+
+        fn create(_ctx: &Context<Self>) -> Self {
+            Self { changed: false }
+        }
+
+        fn update(&mut self, _ctx: &Context<Self>, _msg: Self::Message) -> bool {
+            self.changed = true;
+            true
+        }
+
+        fn view(&self, _ctx: &Context<Self>) -> Html {
+            if self.changed {
+                html! { <view key="changed">{"after"}</view> }
+            } else {
+                html! { <view>{"before"}</view> }
+            }
+        }
+    }
+
+    struct PanickingDestroy;
+
+    impl Component for PanickingDestroy {
+        type Message = ();
+        type Properties = ();
+
+        fn create(_ctx: &Context<Self>) -> Self {
+            Self
+        }
+
+        fn view(&self, _ctx: &Context<Self>) -> Html {
+            html! { <view ontap={|_: ClayEvent| {}}><text>{"mounted"}</text></view> }
+        }
+
+        fn destroy(&mut self, _ctx: &Context<Self>) {
+            panic!("destroy lifecycle panic")
+        }
+    }
