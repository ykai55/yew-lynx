+
+        let result = std::panic::catch_unwind(AssertUnwindSafe(|| app.destroy()));
+
+        assert!(result.is_err());
+        assert_eq!(backend.render_node(ClayNode(1)), "<page></page>");
+        assert_eq!(backend.nodes.borrow().len(), 1);
+        assert!(backend.listeners.borrow().is_empty());
+        assert_eq!(backend.flushes.get(), 2);
+    }
+
+    #[test]
+    fn tap_updates_component_and_clay_tree() {
+        let backend = MockBackend::new();
+        let app = ClayRenderer::<Counter>::new(backend.clone(), ClayNode(1)).render();
+
+        assert_eq!(
+            backend.render_node(ClayNode(1)),
+            "<page><view class=\"counter\"><text>0</text><view><text>Increment</text></view></view></page>"
+        );
+        assert_eq!(backend.flushes.get(), 1);
+
+        backend.tap();
+
+        assert_eq!(
+            backend.render_node(ClayNode(1)),
+            "<page><view class=\"counter\"><text>1</text><view><text>Increment</text></view></view></page>"
+        );
+        assert_eq!(backend.flushes.get(), 2);
+
+        app.destroy();
+        assert_eq!(backend.render_node(ClayNode(1)), "<page></page>");
+        assert_eq!(backend.flushes.get(), 3);
+    }
+}
