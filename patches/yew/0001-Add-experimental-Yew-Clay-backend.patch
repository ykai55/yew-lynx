index 00000000..e8a16a3c
--- /dev/null
+++ b/packages/yew/src/clay_bundle.rs
@@ -0,0 +1,281 @@
+use std::collections::BTreeMap;
+use std::rc::Rc;
+
+use crate::clay_renderer::{ClayBackend, ClayEvent, ClayListener, ClayNode};
+use crate::virtual_dom::{Listeners, VNode, VTag};
+
+pub(crate) struct ClayBundle {
+    vnode: Option<VNode>,
+    kind: ClayBundleKind,
+}
+
+enum ClayBundleKind {
+    Empty,
+    Node {
+        node: ClayNode,
+        children: Vec<ClayBundle>,
+        listeners: Vec<ClayListener>,
+    },
+    List(Vec<ClayBundle>),
+}
+
+struct PendingChildren<'a> {
+    backend: &'a Rc<dyn ClayBackend>,
+    parent: ClayNode,
+    children: Vec<ClayBundle>,
+}
+
+impl PendingChildren<'_> {
+    fn finish(mut self) -> Vec<ClayBundle> {
+        std::mem::take(&mut self.children)
+    }
+}
+
+impl Drop for PendingChildren<'_> {
+    fn drop(&mut self) {
+        for child in std::mem::take(&mut self.children) {
+            child.detach(self.backend, self.parent);
+        }
+    }
+}
+
+struct PendingNode<'a> {
+    backend: &'a Rc<dyn ClayBackend>,
+    parent: ClayNode,
+    node: Option<ClayNode>,
+    inserted: bool,
+    children: Vec<ClayBundle>,
+    listeners: Vec<ClayListener>,
+}
+
+impl PendingNode<'_> {
+    fn finish(mut self) -> ClayBundleKind {
+        ClayBundleKind::Node {
+            node: self.node.take().expect("pending Clay node is missing"),
+            children: std::mem::take(&mut self.children),
+            listeners: std::mem::take(&mut self.listeners),
+        }
+    }
+}
+
+impl Drop for PendingNode<'_> {
+    fn drop(&mut self) {
+        let Some(node) = self.node.take() else {
+            return;
+        };
+        if self.inserted {
+            self.backend.remove(self.parent, node);
+        }
+        for listener in std::mem::take(&mut self.listeners) {
+            self.backend.remove_event_listener(node, listener);
+        }
+        for child in std::mem::take(&mut self.children) {
+            child.detach(self.backend, node);
+        }
+        self.backend.destroy_node(node);
+    }
+}
+
+impl std::fmt::Debug for ClayBundle {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("ClayBundle").finish_non_exhaustive()
+    }
+}
+
+impl ClayBundle {
+    pub(crate) const fn new() -> Self {
+        Self {
+            vnode: None,
+            kind: ClayBundleKind::Empty,
+        }
+    }
+
+    pub(crate) fn reconcile(
+        &mut self,
+        backend: &Rc<dyn ClayBackend>,
+        parent: ClayNode,
+        vnode: VNode,
+    ) {
+        Self::validate(&vnode);
+        if self.vnode.as_ref() == Some(&vnode) {
+            return;
+        }
+
+        let reference = self.first_node();
+        let next = Self::attach(backend, parent, reference, vnode);
+        let previous = std::mem::replace(self, next);
+        previous.detach(backend, parent);
+    }
+
+    pub(crate) fn detach(self, backend: &Rc<dyn ClayBackend>, parent: ClayNode) {
+        match self.kind {
+            ClayBundleKind::Empty => {}
+            ClayBundleKind::List(children) => {
+                for child in children {
+                    child.detach(backend, parent);
+                }
+            }
+            ClayBundleKind::Node {
+                node,
+                children,
+                listeners,
+            } => {
+                backend.remove(parent, node);
+                for listener in listeners {
+                    backend.remove_event_listener(node, listener);
+                }
+                for child in children {
+                    child.detach(backend, node);
+                }
+                backend.destroy_node(node);
+            }
+        }
+    }
+
+    fn first_node(&self) -> Option<ClayNode> {
+        match &self.kind {
+            ClayBundleKind::Empty => None,
+            ClayBundleKind::Node { node, .. } => Some(*node),
+            ClayBundleKind::List(children) => children.iter().find_map(Self::first_node),
+        }
+    }
+
+    fn validate(vnode: &VNode) {
+        if vnode.key().is_some() {
+            panic!("keyed VNodes are not supported by the Clay renderer")
+        }
+
+        match vnode {
+            VNode::VText(_) => {}
+            VNode::VTag(tag) => {
+                if tag.node_ref.is_clay_binding() {
+                    panic!("NodeRef bindings are not supported by the Clay renderer")
+                }
+                if let Listeners::Pending(listeners) = &tag.listeners {
+                    for listener in listeners.iter().flatten() {
+                        let name = listener.kind().type_name();
+                        if name.as_ref() != "tap" {
+                            panic!("event `{name}` is not supported by the Clay renderer")
+                        }
+                    }
+                }
+                if let Some(children) = tag.children() {
+                    Self::validate(children);
+                }
+            }
+            VNode::VList(list) => {
+                for child in list.iter() {
+                    Self::validate(child);
+                }
+            }
+            VNode::VComp(_) => {
+                panic!("nested Yew components are not supported by the Clay renderer yet")
+            }
+            VNode::VRef(_) => panic!("VRef is specific to the browser DOM"),
+            VNode::VPortal(_) => panic!("portals are not supported by the Clay renderer"),
+            VNode::VSuspense(_) => panic!("Suspense is not supported by the Clay renderer"),
+            VNode::VRaw(_) => panic!("raw HTML cannot be rendered by Clay"),
+        }
+    }
+
+    fn attach(
+        backend: &Rc<dyn ClayBackend>,
+        parent: ClayNode,
+        reference: Option<ClayNode>,
+        vnode: VNode,
+    ) -> Self {
+        let kind = match &vnode {
+            VNode::VText(text) => {
+                let node = backend.create_text(&text.text);
+                let mut pending = PendingNode {
+                    backend,
+                    parent,
+                    node: Some(node),
+                    inserted: false,
+                    children: Vec::new(),
+                    listeners: Vec::new(),
+                };
+                backend.insert_before(parent, node, reference);
+                pending.inserted = true;
+                pending.finish()
+            }
+            VNode::VTag(tag) => Self::attach_tag(backend, parent, reference, tag),
+            VNode::VList(list) => {
+                let mut pending = PendingChildren {
+                    backend,
+                    parent,
+                    children: Vec::with_capacity(list.len()),
+                };
+                for child in list.iter() {
+                    pending
+                        .children
+                        .push(Self::attach(backend, parent, reference, child.clone()));
+                }
+                ClayBundleKind::List(pending.finish())
+            }
+            VNode::VComp(_) => unreachable!("Clay VNode validation rejected nested components"),
+            VNode::VRef(_) => panic!("VRef is specific to the browser DOM"),
+            VNode::VPortal(_) => panic!("portals are not supported by the Clay renderer"),
+            VNode::VSuspense(_) => panic!("Suspense is not supported by the Clay renderer"),
+            VNode::VRaw(_) => panic!("raw HTML cannot be rendered by Clay"),
+        };
+
+        Self {
+            vnode: Some(vnode),
+            kind,
+        }
+    }
+
+    fn attach_tag(
+        backend: &Rc<dyn ClayBackend>,
+        parent: ClayNode,
+        reference: Option<ClayNode>,
+        tag: &VTag,
+    ) -> ClayBundleKind {
+        let node = backend.create_element(tag.tag());
+        let mut pending = PendingNode {
+            backend,
+            parent,
+            node: Some(node),
+            inserted: false,
+            children: Vec::new(),
+            listeners: Vec::new(),
+        };
+        let attributes: BTreeMap<&str, &str> = tag.attributes.iter().collect();
+        for (name, value) in attributes {
+            backend.set_attribute(node, name, Some(value));
+        }
+        if let Some(value) = tag.value() {
+            backend.set_attribute(node, "value", Some(value));
+        }
+        if let Some(checked) = tag.checked() {
+            backend.set_attribute(node, "checked", checked.then_some("true"));
+        }
+
+        if let Listeners::Pending(listeners) = &tag.listeners {
+            for listener in listeners.iter().flatten() {
+                let listener = Rc::clone(listener);
+                let name = listener.kind().type_name();
+                let name = match name.as_ref() {
+                    "tap" => "tap",
+                    name => panic!("event `{name}` is not supported by the Clay renderer"),
+                };
+                pending.listeners.push(backend.add_event_listener(
+                    node,
+                    name,
+                    Box::new(move |event: ClayEvent| listener.handle_clay(event)),
+                ));
+            }
+        }
+
+        backend.insert_before(parent, node, reference);
+        pending.inserted = true;
+        if let Some(children) = tag.children() {
+            pending
+                .children
+                .push(Self::attach(backend, node, None, children.clone()));
+        }
+
+        pending.finish()
+    }
+}
diff --git a/packages/yew/src/clay_renderer.rs b/packages/yew/src/clay_renderer.rs
new file mode 100644
index 00000000..425a36b3
--- /dev/null
+++ b/packages/yew/src/clay_renderer.rs
@@ -0,0 +1,669 @@
+use std::fmt;
+use std::ops::Deref;
+use std::panic::{AssertUnwindSafe, catch_unwind, resume_unwind};
+use std::rc::Rc;
+
+use crate::clay_bundle::ClayBundle;
+use crate::html::{BaseComponent, Scope};
+
+/// An opaque node owned by a [`ClayBackend`].
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub struct ClayNode(pub u64);
+
+/// An opaque event-listener registration owned by a [`ClayBackend`].
+#[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
+pub struct ClayListener(pub u64);
+
+/// The event value delivered by the experimental Clay renderer.
+///
+/// The first prototype intentionally carries only the event name. Event detail
+/// can be added without changing Yew's component or reconciliation API.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct ClayEvent {
+    name: Rc<str>,
+}
+
+impl ClayEvent {
+    /// Creates a backend event with a host event name.
+    pub fn new(name: impl Into<Rc<str>>) -> Self {
+        Self { name: name.into() }
+    }
+
+    /// Returns the host event name.
+    pub fn name(&self) -> &str {
+        &self.name
+    }
+}
+
+/// Node operations required by Yew's experimental Clay renderer.
+///
+/// A backend is responsible for forwarding these operations to a concrete
+/// element tree. All methods are called synchronously on the thread that owns
+/// the renderer, and implementations must neither move callbacks to another
+/// thread nor call any backend method from another thread.
+///
+/// Backend methods must not panic. In particular, teardown can run while a
+/// component panic is unwinding, when a second panic would abort the process.
+/// After [`ClayBackend::remove_event_listener`] returns, the callback associated
+/// with that listener must be disconnected and released, and the backend must
+/// never invoke it again. A registered callback may be invoked only on the
+/// renderer's owner thread.
+///
+/// Each created node is initially detached. Insertion gives it one direct
+/// parent, removal makes it detached again, and destruction receives a detached
+/// node whose listeners and direct children have already been removed. The
+/// renderer applies that sequence recursively and never destroys the root node
+/// supplied to [`ClayRenderer`].
+pub trait ClayBackend: fmt::Debug + 'static {
+    /// Creates a container element.
+    fn create_element(&self, tag: &str) -> ClayNode;
+
+    /// Creates a text-content node.
+    fn create_text(&self, text: &str) -> ClayNode;
+
+    /// Inserts detached `child` before a direct child `reference`, or appends it
+    /// when no reference is provided.
+    fn insert_before(&self, parent: ClayNode, child: ClayNode, reference: Option<ClayNode>);
+
+    /// Detaches the direct `child` from `parent` without destroying it.
+    fn remove(&self, parent: ClayNode, child: ClayNode);
+
+    /// Releases a detached node with no listeners or direct children.
+    fn destroy_node(&self, node: ClayNode);
+
+    /// Sets or clears an element attribute.
+    fn set_attribute(&self, node: ClayNode, name: &str, value: Option<&str>);
+
+    /// Registers an event listener.
+    fn add_event_listener(
+        &self,
+        node: ClayNode,
+        name: &str,
+        callback: Box<dyn Fn(ClayEvent)>,
+    ) -> ClayListener;
+
+    /// Synchronously removes an event listener and releases its callback.
+    fn remove_event_listener(&self, node: ClayNode, listener: ClayListener);
+
+    /// Flushes pending element mutations into the host render pipeline.
+    fn flush(&self, root: ClayNode);
+}
+
+/// A mounted Yew application backed by Clay.
+#[derive(Debug)]
+pub struct ClayAppHandle<COMP: BaseComponent> {
+    pub(crate) scope: Scope<COMP>,
+}
+
+impl<COMP: BaseComponent> ClayAppHandle<COMP> {
+    /// Synchronously destroys the application on its owner thread.
+    ///
+    /// If the component's destroy lifecycle panics with unwind enabled, the
+    /// Clay tree and listeners are still removed before the panic resumes.
+    pub fn destroy(self) {
+        self.scope.destroy_clay();
+    }
+}
+
+impl<COMP: BaseComponent> Deref for ClayAppHandle<COMP> {
+    type Target = Scope<COMP>;
+
+    fn deref(&self) -> &Self::Target {
+        &self.scope
+    }
+}
+
+/// Renders a Yew component tree into a [`ClayBackend`] on a native target.
+#[derive(Debug)]
+#[must_use = "ClayRenderer does nothing unless render() is called."]
+pub struct ClayRenderer<COMP: BaseComponent> {
+    backend: Rc<dyn ClayBackend>,
+    root: ClayNode,
+    props: COMP::Properties,
+}
+
+impl<COMP> ClayRenderer<COMP>
+where
+    COMP: BaseComponent<Properties: Default>,
+{
+    /// Creates a renderer with default component properties.
+    pub fn new(backend: Rc<dyn ClayBackend>, root: ClayNode) -> Self {
+        Self::with_props(backend, root, Default::default())
+    }
+}
+
+impl<COMP> ClayRenderer<COMP>
+where
+    COMP: BaseComponent,
+{
+    /// Creates a renderer with explicit component properties.
+    pub fn with_props(
+        backend: Rc<dyn ClayBackend>,
+        root: ClayNode,
+        props: COMP::Properties,
+    ) -> Self {
+        Self {
+            backend,
+            root,
+            props,
+        }
+    }
+
+    /// Mounts the component and synchronously commits its first Clay tree.
+    ///
+    /// Unsupported output panics before host mutation. Cleanup of a later panic
+    /// requires `panic = "unwind"`; aborting panics cannot run cleanup guards.
+    pub fn render(self) -> ClayAppHandle<COMP> {
+        let app = ClayAppHandle {
+            scope: Scope::new(None),
+        };
+        let mounted = catch_unwind(AssertUnwindSafe(|| {
+            app.scope
+                .mount_in_clay(self.backend, self.root, Rc::new(self.props));
+        }));
+        if let Err(payload) = mounted {
+            app.scope.clone().destroy_clay();
+            resume_unwind(payload);
+        }
+        app
+    }
+}
+
+pub(crate) fn empty_bundle() -> ClayBundle {
+    ClayBundle::new()
+}
+
+#[cfg(test)]
+mod tests {
+    use std::cell::{Cell, RefCell};
+    use std::collections::{BTreeMap, HashMap};
+    use std::fmt::Write as _;
+
+    use super::*;
+    use crate::html::NodeRef;
+    use crate::{Component, Context, Html, Properties, function_component, html, use_state};
+
+    #[derive(Debug)]
+    struct NodeState {
+        tag: String,
+        text: Option<String>,
+        attributes: BTreeMap<String, String>,
+        parent: Option<ClayNode>,
+        children: Vec<ClayNode>,
+    }
+
+    struct ListenerState {
+        node: ClayNode,
+        name: String,
+        callback: Rc<dyn Fn(ClayEvent)>,
+    }
+
+    struct MockBackend {
+        next_node: Cell<u64>,
+        next_listener: Cell<u64>,
+        nodes: RefCell<HashMap<ClayNode, NodeState>>,
+        listeners: RefCell<HashMap<ClayListener, ListenerState>>,
+        flushes: Cell<usize>,
+    }
+
+    impl fmt::Debug for MockBackend {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.debug_struct("MockBackend").finish_non_exhaustive()
+        }
+    }
+
+    impl MockBackend {
+        fn new() -> Rc<Self> {
+            let root = ClayNode(1);
+            Rc::new(Self {
+                next_node: Cell::new(2),
+                next_listener: Cell::new(1),
+                nodes: RefCell::new(HashMap::from([(
+                    root,
+                    NodeState {
+                        tag: "page".into(),
+                        text: None,
+                        attributes: BTreeMap::new(),
+                        parent: None,
+                        children: Vec::new(),
+                    },
+                )])),
+                listeners: RefCell::new(HashMap::new()),
+                flushes: Cell::new(0),
+            })
+        }
+
+        fn create_node(&self, tag: &str, text: Option<&str>) -> ClayNode {
+            let node = ClayNode(self.next_node.get());
+            self.next_node.set(node.0 + 1);
+            self.nodes.borrow_mut().insert(
+                node,
+                NodeState {
+                    tag: tag.into(),
+                    text: text.map(Into::into),
+                    attributes: BTreeMap::new(),
+                    parent: None,
+                    children: Vec::new(),
+                },
+            );
+            node
+        }
+
+        fn render_node(&self, node: ClayNode) -> String {
+            let nodes = self.nodes.borrow();
+            fn render(nodes: &HashMap<ClayNode, NodeState>, node: ClayNode) -> String {
+                let state = &nodes[&node];
+                if let Some(text) = &state.text {
+                    return text.clone();
+                }
+                let mut attributes = String::new();
+                for (name, value) in &state.attributes {
+                    write!(&mut attributes, " {name}=\"{value}\"").unwrap();
+                }
+                let children = state
+                    .children
+                    .iter()
+                    .map(|child| render(nodes, *child))
+                    .collect::<String>();
+                format!("<{tag}{attributes}>{children}</{tag}>", tag = state.tag)
+            }
+            render(&nodes, node)
+        }
+
+        fn tap(&self) {
+            let callback = self
+                .listeners
+                .borrow()
+                .values()
+                .find(|listener| listener.name == "tap")
+                .map(|listener| Rc::clone(&listener.callback))
+                .expect("tap listener not found");
+            callback(ClayEvent::new("tap"));
+        }
+    }
+
+    impl ClayBackend for MockBackend {
+        fn create_element(&self, tag: &str) -> ClayNode {
+            self.create_node(tag, None)
+        }
+
+        fn create_text(&self, text: &str) -> ClayNode {
+            self.create_node("text", Some(text))
+        }
+
+        fn insert_before(&self, parent: ClayNode, child: ClayNode, reference: Option<ClayNode>) {
+            {
+                let nodes = self.nodes.borrow();
+                assert!(nodes.contains_key(&parent));
+                assert_eq!(nodes.get(&child).unwrap().parent, None);
+                if let Some(reference) = reference {
+                    assert_eq!(nodes.get(&reference).unwrap().parent, Some(parent));
+                }
+            }
+            let mut nodes = self.nodes.borrow_mut();
+            let children = &mut nodes.get_mut(&parent).unwrap().children;
+            let index = reference.map_or(children.len(), |reference| {
+                children
+                    .iter()
+                    .position(|candidate| *candidate == reference)
+                    .unwrap()
+            });
+            children.insert(index, child);
+            nodes.get_mut(&child).unwrap().parent = Some(parent);
+        }
+
+        fn remove(&self, parent: ClayNode, child: ClayNode) {
+            let mut nodes = self.nodes.borrow_mut();
+            assert_eq!(nodes.get(&child).unwrap().parent, Some(parent));
+            let children = &mut nodes.get_mut(&parent).unwrap().children;
+            let index = children
+                .iter()
+                .position(|candidate| *candidate == child)
+                .unwrap();
+            children.remove(index);
+            nodes.get_mut(&child).unwrap().parent = None;
+        }
+
+        fn destroy_node(&self, node: ClayNode) {
+            assert!(
+                self.listeners
+                    .borrow()
+                    .values()
+                    .all(|listener| listener.node != node)
+            );
+            let mut nodes = self.nodes.borrow_mut();
+            let state = nodes.get(&node).unwrap();
+            assert_eq!(state.parent, None);
+            assert!(state.children.is_empty());
+            nodes.remove(&node).unwrap();
+        }
+
+        fn set_attribute(&self, node: ClayNode, name: &str, value: Option<&str>) {
+            let mut nodes = self.nodes.borrow_mut();
+            let attributes = &mut nodes.get_mut(&node).unwrap().attributes;
+            match value {
+                Some(value) => {
+                    attributes.insert(name.into(), value.into());
+                }
+                None => {
+                    attributes.remove(name);
+                }
+            }
+        }
+
+        fn add_event_listener(
+            &self,
+            node: ClayNode,
+            name: &str,
+            callback: Box<dyn Fn(ClayEvent)>,
+        ) -> ClayListener {
+            let listener = ClayListener(self.next_listener.get());
+            self.next_listener.set(listener.0 + 1);
+            self.listeners.borrow_mut().insert(
+                listener,
+                ListenerState {
+                    node,
+                    name: name.into(),
+                    callback: Rc::from(callback),
+                },
+            );
+            listener
+        }
+
+        fn remove_event_listener(&self, node: ClayNode, listener: ClayListener) {
+            let removed = self.listeners.borrow_mut().remove(&listener).unwrap();
+            assert_eq!(node, removed.node);
+        }
+
+        fn flush(&self, _root: ClayNode) {
+            self.flushes.set(self.flushes.get() + 1);
+        }
+    }
+
+    #[function_component]
+    fn Counter() -> Html {
+        let value = use_state(|| 0);
+        let increment = {
+            let value = value.clone();
+            move |_: ClayEvent| value.set(*value + 1)
+        };
+
+        html! {
+            <view class="counter">
+                <text>{*value}</text>
+                <view ontap={increment}>
+                    <text>{"Increment"}</text>
+                </view>
+            </view>
+        }
+    }
+
+    #[function_component]
+    fn Nested() -> Html {
+        html! { <text>{"Nested"}</text> }
+    }
+
+    #[function_component]
+    fn UnsupportedNestedComponent() -> Html {
+        html! { <view ontap={|_: ClayEvent| {}}><Nested /></view> }
+    }
+
+    #[function_component]
+    fn UnsupportedSiblingComponent() -> Html {
+        html! { <text>{"First"}</text><Nested /> }
+    }
+
+    #[function_component]
+    fn UnsupportedNodeRef() -> Html {
+        let node_ref = NodeRef::default();
+        html! { <view ref={node_ref} /> }
+    }
+
+    #[function_component]
+    fn FormControls() -> Html {
+        html! {
+            <view>
+                <input value="ready" checked={true} />
+                <input value="off" checked={false} />
+                <textarea value="notes" />
+            </view>
+        }
+    }
+
+    #[function_component]
+    fn NestedTree() -> Html {
+        html! { <view><text><view>{"leaf"}</view></text></view> }
+    }
+
+    #[derive(Clone, PartialEq, Properties)]
+    struct LifecycleProps {
+        events: Rc<RefCell<Vec<&'static str>>>,
+    }
+
+    enum LifecycleMessage {
+        Render,
+    }
+
+    struct LifecycleComponent;
+
+    impl Component for LifecycleComponent {
+        type Message = LifecycleMessage;
+        type Properties = LifecycleProps;
+
+        fn create(_ctx: &Context<Self>) -> Self {
+            Self
+        }
+
+        fn update(&mut self, _ctx: &Context<Self>, _msg: Self::Message) -> bool {
+            true
+        }
+
+        fn view(&self, _ctx: &Context<Self>) -> Html {
+            html! { <view /> }
+        }
+
+        fn rendered(&mut self, ctx: &Context<Self>, first_render: bool) {
+            ctx.props().events.borrow_mut().push(if first_render {
+                "rendered:first"
+            } else {
+                "rendered"
+            });
+        }
+
+        fn destroy(&mut self, ctx: &Context<Self>) {
+            ctx.props().events.borrow_mut().push("destroy");
+        }
+    }
+
+    enum KeyMessage {
+        Change,
+    }
+
+    struct KeyChange {
+        changed: bool,
+    }
+
+    impl Component for KeyChange {
