 #include "core/public/ui_delegate.h"
 #include "core/renderer/data/android/platform_data_android.h"
 #include "core/renderer/dom/android/lepus_message_consumer.h"
+#include "core/renderer/native_renderer.h"
 #include "core/renderer/utils/android/event_converter_android.h"
 #include "core/renderer/utils/android/value_converter_android.h"
 #include "core/renderer/utils/base/base_def.h"
@@ -431,6 +432,57 @@ void Destroy(JNIEnv* env, jclass jcaller, jlong ptr) {
   delete reinterpret_cast<LynxShell*>(ptr);
 }
 
+jlong RegisterNativeRendererHost(JNIEnv* env, jclass jcaller, jlong ptr,
+                                 jlong lifecycle) {
+  AtomicLifecycle* lifecycle_ptr =
+      reinterpret_cast<AtomicLifecycle*>(lifecycle);
+  if (!AtomicLifecycle::TryLock(lifecycle_ptr)) {
+    return 0;
+  }
+  auto* shell = reinterpret_cast<LynxShell*>(ptr);
+  LynxNativeHostHandle host = 0;
+  if (shell != nullptr &&
+      shell->ThreadStrategy() ==
+          lynx::base::ThreadStrategyForRendering::ALL_ON_UI &&
+      shell->CanRunOnTasmThreadNow()) {
+    host = lynx::tasm::RegisterNativeRendererHost(shell->GetTasm());
+  }
+  AtomicLifecycle::TryFree(lifecycle_ptr);
+  return static_cast<jlong>(host);
+}
+
+jboolean UnregisterNativeRendererHost(JNIEnv* env, jclass jcaller, jlong ptr,
+                                      jlong lifecycle, jlong host) {
+  AtomicLifecycle* lifecycle_ptr =
+      reinterpret_cast<AtomicLifecycle*>(lifecycle);
+  if (!AtomicLifecycle::TryLock(lifecycle_ptr)) {
+    return JNI_FALSE;
+  }
+  auto* shell = reinterpret_cast<LynxShell*>(ptr);
+  const bool unregistered =
+      shell != nullptr && shell->CanRunOnTasmThreadNow() &&
+      lynx::tasm::UnregisterNativeRendererHost(
+          static_cast<LynxNativeHostHandle>(host), shell->GetTasm());
+  AtomicLifecycle::TryFree(lifecycle_ptr);
+  return unregistered ? JNI_TRUE : JNI_FALSE;
+}
+
+jboolean DestroyNativeRendererHost(JNIEnv* env, jclass jcaller, jlong ptr,
+                                   jlong lifecycle, jlong host) {
+  AtomicLifecycle* lifecycle_ptr =
+      reinterpret_cast<AtomicLifecycle*>(lifecycle);
+  if (!AtomicLifecycle::TryLock(lifecycle_ptr)) {
+    return JNI_FALSE;
+  }
+  auto* shell = reinterpret_cast<LynxShell*>(ptr);
+  const bool destroyed =
+      shell != nullptr && shell->CanRunOnTasmThreadNow() &&
+      lynx::tasm::DestroyNativeRendererHost(
+          static_cast<LynxNativeHostHandle>(host), shell->GetTasm());
+  AtomicLifecycle::TryFree(lifecycle_ptr);
+  return destroyed ? JNI_TRUE : JNI_FALSE;
+}
+
 jlong LifecycleCreate(JNIEnv* env, jclass jclass) {
   return reinterpret_cast<jlong>(new AtomicLifecycle());
 }
