@@ -2679,6 +2680,52 @@ public class LynxTemplateRender
     return mThreadStrategyForRendering;
   }
 
+  /** Registers this renderer for use through the Native Renderer C API. */
+  public synchronized long registerNativeRendererHost() {
+    if (!UIThreadUtils.isOnUiThread()) {
+      throw new IllegalStateException("Native renderer host must be registered on the UI thread");
+    }
+    if (mThreadStrategyForRendering != ThreadStrategyForRendering.ALL_ON_UI) {
+      throw new IllegalStateException("Native renderer host requires ALL_ON_UI rendering");
+    }
+    if (mNativePtr == 0 || mNativeLifecycle == 0 || mIsDestroyed.get() || mHasDestroy
+        || mDestroying) {
+      throw new IllegalStateException("LynxTemplateRender is destroyed");
+    }
+    if (mNativeRendererHost != 0) {
+      throw new IllegalStateException("Native renderer host is already registered");
+    }
+    long host = nativeRegisterNativeRendererHost(mNativePtr, mNativeLifecycle);
+    if (host == 0) {
+      throw new IllegalStateException("Unable to register native renderer host");
+    }
+    mNativeRendererHost = host;
+    return host;
+  }
+
+  /** Unregisters the exact token returned by {@link #registerNativeRendererHost}. */
+  public synchronized void unregisterNativeRendererHost(long host) {
+    if (!UIThreadUtils.isOnUiThread()) {
+      throw new IllegalStateException("Native renderer host must be unregistered on the UI thread");
+    }
+    if (host == 0) {
+      throw new IllegalArgumentException("Native renderer host token must not be zero");
+    }
+    if (mNativeRendererHost == 0) {
+      throw new IllegalStateException("Native renderer host is not registered");
+    }
+    if (host != mNativeRendererHost) {
+      throw new IllegalArgumentException("Native renderer host token is stale");
+    }
+    if (mNativePtr == 0 || mNativeLifecycle == 0 || mIsDestroyed.get() || mHasDestroy) {
+      throw new IllegalStateException("LynxTemplateRender is destroyed");
+    }
+    if (!nativeUnregisterNativeRendererHost(mNativePtr, mNativeLifecycle, host)) {
+      throw new IllegalStateException("Native renderer host is still in use");
+    }
+    mNativeRendererHost = 0;
+  }
+
