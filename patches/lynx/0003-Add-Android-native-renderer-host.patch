From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ykai55 <ykai55@users.noreply.github.com>
Date: Fri, 21 Aug 2026 16:00:00 +0800
Subject: [PATCH 3/3] Add Android native renderer host

Expose generation-checked Native Renderer host tokens through LynxView and
LynxTemplateRender, enforce ALL_ON_UI ownership, and invalidate outstanding
renderer state before Android host teardown.

---
diff --git a/core/renderer/native_renderer.cc b/core/renderer/native_renderer.cc
index 0248d9d21c7ffca9ed2ce3b760f8af7d0167f378..c211f99eda9a319041a31b5648812161d890bdee 100644
--- a/core/renderer/native_renderer.cc
+++ b/core/renderer/native_renderer.cc
@@ -262,6 +262,13 @@ class HostRegistry {
     return true;
   }
 
+  bool Owns(LynxNativeHostHandle handle, TemplateAssembler* tasm) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Slot* slot = GetLocked(handle);
+    return slot != nullptr && slot->tasm == tasm &&
+           slot->owner == std::this_thread::get_id();
+  }
+
   Status Reserve(LynxNativeHostHandle handle, TemplateAssembler** tasm) {
     if (handle == 0) {
       return kInvalidArgument;
@@ -333,10 +340,12 @@ class Session;
 
 class RendererRegistry {
  public:
-  LynxNativeRendererHandle Insert(std::shared_ptr<Session> session) {
+  LynxNativeRendererHandle Insert(LynxNativeHostHandle host,
+                                  std::shared_ptr<Session> session) {
     std::lock_guard<std::mutex> lock(mutex_);
     for (size_t i = 0; i < slots_.size(); ++i) {
       if (slots_[i].session == nullptr) {
+        slots_[i].host = host;
         slots_[i].session = std::move(session);
         return Encode(i, slots_[i].generation);
       }
@@ -344,7 +353,7 @@ class RendererRegistry {
     if (slots_.size() >= std::numeric_limits<uint32_t>::max()) {
       return 0;
     }
-    slots_.push_back({1, std::move(session)});
+    slots_.push_back({1, host, std::move(session)});
     return Encode(slots_.size() - 1, slots_.back().generation);
   }
 
@@ -354,6 +363,18 @@ class RendererRegistry {
     return slot == nullptr ? nullptr : slot->session;
   }
 
+  std::vector<std::shared_ptr<Session>> GetForHost(
+      LynxNativeHostHandle host) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<std::shared_ptr<Session>> sessions;
+    for (const Slot& slot : slots_) {
+      if (slot.host == host && slot.session != nullptr) {
+        sessions.push_back(slot.session);
+      }
+    }
+    return sessions;
+  }
+
   bool Remove(LynxNativeRendererHandle handle,
               const std::shared_ptr<Session>& expected) {
     std::lock_guard<std::mutex> lock(mutex_);
@@ -361,6 +382,7 @@ class RendererRegistry {
     if (slot == nullptr || slot->session != expected) {
       return false;
     }
+    slot->host = 0;
     slot->session.reset();
     slot->generation = NextGeneration(slot->generation);
     return true;
@@ -369,6 +391,7 @@ class RendererRegistry {
  private:
   struct Slot {
     uint32_t generation{1};
+    LynxNativeHostHandle host{0};
     std::shared_ptr<Session> session;
   };
 
@@ -454,6 +477,12 @@ class Session final : public std::enable_shared_from_this<Session> {
     renderer_ = renderer;
   }
 
+  LynxNativeRendererHandle renderer_handle() const { return renderer_; }
+
+  bool CanReleaseSynchronously() const {
+    return CheckThread() == kOk && dispatch_depth_ == 0;
+  }
+
   Status CheckThread() const {
     return owner_ == std::this_thread::get_id() ? kOk : kWrongThread;
   }
@@ -1104,7 +1133,7 @@ Status Acquire(LynxNativeHostHandle host,
       session->BeginRelease();
       return status;
     }
-    LynxNativeRendererHandle handle = Renderers().Insert(session);
+    LynxNativeRendererHandle handle = Renderers().Insert(host, session);
     if (handle == 0) {
       session->BeginRelease();
       return kResourceExhausted;
@@ -1283,6 +1312,48 @@ bool UnregisterNativeRendererHost(LynxNativeHostHandle host) {
 #endif
 }
 
+bool UnregisterNativeRendererHost(LynxNativeHostHandle host,
+                                  TemplateAssembler* expected_tasm) {
+#if defined(__cpp_exceptions)
+  try {
+#endif
+    return Hosts().Owns(host, expected_tasm) && Hosts().Unregister(host);
+#if defined(__cpp_exceptions)
+  } catch (...) {
+    return false;
+  }
+#endif
+}
+
+bool DestroyNativeRendererHost(LynxNativeHostHandle host,
+                               TemplateAssembler* expected_tasm) {
+#if defined(__cpp_exceptions)
+  try {
+#endif
+    if (!Hosts().Owns(host, expected_tasm)) {
+      return false;
+    }
+    std::vector<std::shared_ptr<Session>> sessions =
+        Renderers().GetForHost(host);
+    for (const auto& session : sessions) {
+      if (!session->CanReleaseSynchronously()) {
+        return false;
+      }
+    }
+    for (const auto& session : sessions) {
+      if (!Renderers().Remove(session->renderer_handle(), session) ||
+          session->BeginRelease() != kOk) {
+        return false;
+      }
+    }
+    return Hosts().Unregister(host);
+#if defined(__cpp_exceptions)
+  } catch (...) {
+    return false;
+  }
+#endif
+}
+
 }  // namespace tasm
 }  // namespace lynx
 
