+uint32_t AllocateResourceHandle() {
+  static std::atomic<uint32_t> next_handle{1};
+  uint32_t handle = next_handle.load(std::memory_order_relaxed);
+  while (handle != 0) {
+    const uint32_t following =
+        handle == std::numeric_limits<uint32_t>::max() ? 0 : handle + 1;
+    if (next_handle.compare_exchange_weak(handle, following,
+                                          std::memory_order_relaxed)) {
+      return handle;
+    }
+  }
+  return 0;
 }
 
