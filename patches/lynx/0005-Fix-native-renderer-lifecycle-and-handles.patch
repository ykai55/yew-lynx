+TEST(NativeRendererApiTest, ResourceHandlesDoNotAliasAcrossRenderers) {
+  NativeRendererHarness first_harness;
+  NativeRendererHarness second_harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  CallbackState first_state{api};
+  CallbackState second_state{api};
+  LynxNativeRendererCallbacksV1 first_callbacks{&first_state, &OnEvent,
+                                                &OnTimer};
+  LynxNativeRendererCallbacksV1 second_callbacks{&second_state, &OnEvent,
+                                                 &OnTimer};
+  LynxNativeHostHandle first_host =
+      RegisterNativeRendererHost(first_harness.tasm_.get());
+  LynxNativeHostHandle second_host =
+      RegisterNativeRendererHost(second_harness.tasm_.get());
+  ASSERT_NE(first_host, 0u);
+  ASSERT_NE(second_host, 0u);
+
+  LynxNativeRendererHandle first_renderer = 0;
+  LynxNativeRendererHandle second_renderer = 0;
+  ASSERT_EQ(api->acquire(first_host, &first_callbacks, &first_renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->acquire(second_host, &second_callbacks, &second_renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  LynxNativeNodeHandle first_root = 0;
+  LynxNativeNodeHandle second_root = 0;
+  ASSERT_EQ(api->get_root(first_renderer, &first_root),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->get_root(second_renderer, &second_root),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_NE(first_root, second_root);
+  EXPECT_EQ(api->set_attribute(second_renderer, first_root, Utf8("id"),
+                               Utf8("foreign")),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_OWNERSHIP);
+
+  LynxNativeTimerHandle first_timer = 0;
+  LynxNativeTimerHandle second_timer = 0;
+  ASSERT_EQ(api->create_timer(first_renderer, 60000, 0, 1, &first_timer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->create_timer(second_renderer, 60000, 0, 2, &second_timer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_NE(first_timer, second_timer);
+  EXPECT_EQ(api->cancel_timer(second_renderer, first_timer),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_OWNERSHIP);
+  EXPECT_EQ(api->cancel_timer(first_renderer, first_timer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->cancel_timer(second_renderer, second_timer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  EXPECT_EQ(api->release(first_renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->release(second_renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(first_host));
+  EXPECT_TRUE(UnregisterNativeRendererHost(second_host));
+}
