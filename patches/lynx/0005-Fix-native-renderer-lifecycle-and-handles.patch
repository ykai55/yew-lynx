+TEST(NativeRendererApiTest, NodeHandlesDoNotAliasAfterGenerationWrap) {
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  LynxNativeNodeHandle stale = 0;
+  ASSERT_EQ(api->create_element(renderer, Utf8("view"), &stale),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->destroy_node(renderer, stale), LYNX_NATIVE_RENDERER_STATUS_OK);
+  for (size_t i = 0; i < 65534; ++i) {
+    LynxNativeNodeHandle node = 0;
+    ASSERT_EQ(api->create_element(renderer, Utf8("view"), &node),
+              LYNX_NATIVE_RENDERER_STATUS_OK);
+    ASSERT_EQ(api->destroy_node(renderer, node),
+              LYNX_NATIVE_RENDERER_STATUS_OK);
+  }
+  LynxNativeNodeHandle current = 0;
+  ASSERT_EQ(api->create_element(renderer, Utf8("view"), &current),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_NE(stale, current);
+  EXPECT_EQ(api->set_attribute(renderer, stale, Utf8("id"), Utf8("stale")),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_OWNERSHIP);
+  EXPECT_EQ(api->destroy_node(renderer, current),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
