+  Status ImportStyleSheet(LynxNativeBytes bytes) {
+    Status status = CheckCall();
+    if (status != kOk) {
+      return status;
+    }
+    if (bytes.data == nullptr || bytes.len == 0) {
+      return kInvalidArgument;
+    }
+
+    CompileOptions options = CreateNativeCSSCompileOptions();
+
+    std::vector<uint8_t> data(bytes.data, bytes.data + bytes.len);
+    auto input = std::make_unique<lepus::ByteArrayInputStream>(std::move(data));
+    RuntimeCSSReader reader(std::move(input), options,
+                            kNativeCSSInlineVariablesEnabled);
+    auto fragment = std::make_unique<SharedCSSFragment>();
+    if (!reader.DecodeCSSFragment(fragment.get(), bytes.len) ||
+        reader.DecodedCSSFragmentEnd() != bytes.len) {
+      return kInvalidArgument;
+    }
+
+    auto wrapper = fml::MakeRefCounted<SharedCSSFragmentWrapper>(
+        std::move(fragment));
+    imported_style_sheets_.push_back(wrapper);
+    manager_->AdoptStyleSheet(wrapper);
+    if (root_ != nullptr) {
+      root_->ApplyFunctionRecursive(
+          [](auto element) { element->MarkStyleDirty(false); });
+    }
+    return kOk;
+  }
+
+  Status ClearStyleSheets() {
+    Status status = CheckCall();
+    if (status != kOk) {
+      return status;
+    }
+    RemoveImportedStyleSheets();
+    if (root_ != nullptr) {
+      root_->ApplyFunctionRecursive(
+          [](auto element) { element->MarkStyleDirty(false); });
+    }
+    return kOk;
+  }
