+class CSSFragmentEncoder : public TemplateBinaryWriter {
+ public:
+  CSSFragmentEncoder(CSSParser* parser, const CompileOptions& options)
+      : TemplateBinaryWriter(nullptr, runtime::VMContextType, false, nullptr,
+                             parser, nullptr, nullptr, nullptr, nullptr, "", "",
+                             "", "", "", "", {}, options, lepus::Value(),
+                             lepus::Value(), {}, nullptr) {}
+
+  std::vector<uint8_t> Encode(encoder::SharedCSSFragment* fragment) {
+    return EncodeCSSFragmentToVector(fragment);
+  }
+};
+
+std::vector<uint8_t> EncodeClassStyleSheet() {
+  CompileOptions options = CreateNativeCSSCompileOptions();
+  CSSParser parser(options);
+  rapidjson::Document rules;
+  rules.Parse(R"([{
+    "type": "StyleRule",
+    "selectorText": {"value": ".compiled", "loc": {"line": 1, "column": 1}},
+    "style": [{"name": "width", "value": "123px", "keyLoc": {"line": 1, "column": 13}}],
+    "variables": {}
+  }])");
+  if (rules.HasParseError()) {
+    return {};
+  }
+  auto fragment = parser.ParseExternalFragment(rules, "/native.css");
+  if (fragment == nullptr) {
+    return {};
+  }
+  CSSFragmentEncoder encoder(&parser, options);
+  return encoder.Encode(fragment.get());
+}
