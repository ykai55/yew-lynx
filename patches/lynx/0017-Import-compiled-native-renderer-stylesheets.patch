+  bool RemoveAdoptedStyleSheet(
+      const fml::RefPtr<tasm::SharedCSSFragmentWrapper> &wrapper) {
+    std::unique_lock<std::shared_mutex> lock(adopted_style_sheets_mutex_);
+    for (auto it = adopted_stylesheets_.begin();
+         it != adopted_stylesheets_.end(); ++it) {
+      if (it->get() != wrapper.get()) {
+        continue;
+      }
+      adopted_stylesheets_.erase(it);
+      uint8_t feature_flags = css::RuleSet::kNoFeatures;
+      for (const auto &remaining : adopted_stylesheets_) {
+        if (remaining && remaining->fragment_) {
+          feature_flags |= remaining->fragment_->GetFeatureFlags();
+        }
+      }
+      adopted_feature_flags_.store(feature_flags, std::memory_order_release);
+      cascade_layer_map_cache_.clear();
+      return true;
+    }
+    return false;
+  }
+
   // Iterates adopted stylesheets under a shared lock without copying.
   // Visitor returns true to continue, false to stop early.
   template <typename Visitor>
