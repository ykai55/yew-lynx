+TEST(NativeRendererApiTest, ImportsCompiledStyleSheetThroughFunctionTable) {
+  NativeRendererHarness harness;
+  auto external_before = fml::MakeRefCounted<SharedCSSFragmentWrapper>(
+      std::make_unique<SharedCSSFragment>());
+  harness.manager_->AdoptStyleSheet(external_before);
+  const auto* api = lynx_native_renderer_get_api(1);
+  ASSERT_NE(api, nullptr);
+  ASSERT_NE(api->import_style_sheet, nullptr);
+  ASSERT_NE(api->clear_style_sheets, nullptr);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  auto external_after = fml::MakeRefCounted<SharedCSSFragmentWrapper>(
+      std::make_unique<SharedCSSFragment>());
+  harness.manager_->AdoptStyleSheet(external_after);
+
+  EXPECT_EQ(api->import_style_sheet(renderer, {nullptr, 0}),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+
+  std::vector<uint8_t> fragment = EncodeClassStyleSheet();
+  ASSERT_FALSE(fragment.empty());
+  EXPECT_EQ(api->import_style_sheet(renderer,
+                                    {fragment.data(), fragment.size() / 2}),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(harness.manager_->GetAdoptedStyleSheets().size(), 2u);
+  std::vector<uint8_t> trailing = fragment;
+  trailing.push_back(0);
+  EXPECT_EQ(api->import_style_sheet(renderer,
+                                    {trailing.data(), trailing.size()}),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(harness.manager_->GetAdoptedStyleSheets().size(), 2u);
+  std::vector<uint8_t> concatenated = fragment;
+  concatenated.insert(concatenated.end(), fragment.begin(), fragment.end());
+  EXPECT_EQ(api->import_style_sheet(
+                renderer, {concatenated.data(), concatenated.size()}),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(harness.manager_->GetAdoptedStyleSheets().size(), 2u);
+  ASSERT_EQ(api->import_style_sheet(renderer,
+                                    {fragment.data(), fragment.size()}),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  LynxNativeNodeHandle root = 0;
+  LynxNativeNodeHandle node = 0;
+  ASSERT_EQ(api->get_root(renderer, &root), LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->create_element(renderer, Utf8("view"), &node),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->set_attribute(renderer, node, Utf8("class"),
+                               Utf8("compiled")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->insert_before(renderer, root, node, 0),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->flush(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  Element* element = harness.manager_->root()->GetChildAt(0);
+  auto width = element->GetElementStyle(CSSPropertyID::kPropertyIDWidth);
+  ASSERT_TRUE(width.has_value());
+  EXPECT_EQ(CSSDecoder::CSSValueToString(CSSPropertyID::kPropertyIDWidth,
+                                         *width),
+            "123px");
+
+  ASSERT_EQ(api->clear_style_sheets(renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  auto after_clear = harness.manager_->GetAdoptedStyleSheets();
+  ASSERT_EQ(after_clear.size(), 2u);
+  EXPECT_EQ(after_clear[0].get(), external_before.get());
+  EXPECT_EQ(after_clear[1].get(), external_after.get());
+  ASSERT_EQ(api->flush(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_FALSE(
+      element->GetElementStyle(CSSPropertyID::kPropertyIDWidth).has_value());
+
+  ASSERT_EQ(api->import_style_sheet(renderer,
+                                    {fragment.data(), fragment.size()}),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(harness.manager_->GetAdoptedStyleSheets().size(), 3u);
+
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  const auto remaining = harness.manager_->GetAdoptedStyleSheets();
+  ASSERT_EQ(remaining.size(), 2u);
+  EXPECT_EQ(remaining[0].get(), external_before.get());
+  EXPECT_EQ(remaining[1].get(), external_after.get());
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
