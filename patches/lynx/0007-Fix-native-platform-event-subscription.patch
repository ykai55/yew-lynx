From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ykai55 <ykai55@users.noreply.github.com>
Date: Fri, 21 Aug 2026 23:00:00 +0800
Subject: [PATCH 7/7] Fix native platform event subscription

Advertise native event names through the Element data model so platform touch
targeting sees the same bindEvent state as Fiber events. Keep the inert JS
handler empty and retain callback delivery exclusively in NativeEventListener.

---
 core/renderer/native_renderer.cc          | 24 +++++--
 core/renderer/native_renderer_unittest.cc | 83 ++++++++++++++++++++++-
 2 files changed, 100 insertions(+), 7 deletions(-)

diff --git a/core/renderer/native_renderer.cc b/core/renderer/native_renderer.cc
index e951ea6160a8d159bf46d8db7de6fe4287c071b2..7c7968532a31635a0acb7ee9adb0b35d9d800e18 100644
--- a/core/renderer/native_renderer.cc
+++ b/core/renderer/native_renderer.cc
@@ -1021,16 +1021,30 @@ class Session final : public std::enable_shared_from_this<Session> {
   }
 
   void RebuildPlatformEventSubscriptions(Element* node) {
-    node->ResetEventHandlers();
     std::unordered_set<std::string> event_names;
     for (const auto& pair : listeners_) {
       const ListenerEntry& entry = pair.second;
-      if (entry.node.get() == node && event_names.insert(entry.name).second) {
-        EventHandler handler(base::String(kEventBindEvent),
-                             base::String(entry.name), base::String());
-        node->SetEventHandler(base::String(entry.name), &handler);
+      if (entry.node.get() == node) {
+        event_names.insert(entry.name);
+      }
+    }
+
+    std::vector<std::pair<base::String, base::String>> removed_events;
+    for (const auto& event : node->event_map()) {
+      if (event_names.count(event.first.str()) == 0) {
+        removed_events.emplace_back(event.first, event.second->type());
       }
     }
+    for (const auto& event : removed_events) {
+      node->RemoveEvent(event.first, event.second);
+    }
+    for (const auto& event_name : event_names) {
+      node->SetJSEventHandler(base::String(event_name),
+                              base::String(kEventBindEvent), base::String());
+    }
+
+    node->PreparePropBundleIfNeed();
+    node->ResetEventHandlers();
     node->MarkPropsDirty();
   }
 
diff --git a/core/renderer/native_renderer_unittest.cc b/core/renderer/native_renderer_unittest.cc
index 2de51360d40b4e205cc4a4ead87fbe0f991576a6..ed99589b7b0ff5af7a8d27333310b57b9dfe7db5 100644
--- a/core/renderer/native_renderer_unittest.cc
+++ b/core/renderer/native_renderer_unittest.cc
@@ -33,6 +33,8 @@ struct CallbackState {
   const LynxNativeRendererApiV1* api{nullptr};
   int event_count{0};
   int timer_count{0};
+  LynxNativeListenerHandle event_listener{0};
+  LynxNativeCallbackHandle event_callback{0};
   bool release_from_event{false};
   bool release_from_timer{false};
   bool throw_from_event{false};
@@ -46,12 +48,15 @@ struct CallbackState {
 
 LynxNativeRendererStatus OnEvent(void* context,
                                  LynxNativeRendererHandle renderer,
-                                 LynxNativeListenerHandle,
-                                 LynxNativeCallbackHandle, LynxNativeUtf8 name,
+                                 LynxNativeListenerHandle listener,
+                                 LynxNativeCallbackHandle callback,
+                                 LynxNativeUtf8 name,
                                  LynxNativeUtf8 content_type,
                                  LynxNativeBytes payload) {
   auto* state = static_cast<CallbackState*>(context);
   ++state->event_count;
+  state->event_listener = listener;
+  state->event_callback = callback;
   state->event_name.assign(reinterpret_cast<const char*>(name.data), name.len);
   state->content_type.assign(reinterpret_cast<const char*>(content_type.data),
                              content_type.len);
@@ -421,6 +426,80 @@ TEST(NativeRendererApiTest, ListenerRemovalUsesExactIdentityAndReleaseDefers) {
   EXPECT_TRUE(UnregisterNativeRendererHost(host));
 }
 
+TEST(NativeRendererApiTest,
+     NativeEventsAdvertisePlatformSubscriptionUntilLastListenerIsRemoved) {
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  ASSERT_NE(api, nullptr);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  LynxNativeNodeHandle root = 0;
+  LynxNativeNodeHandle node = 0;
+  ASSERT_EQ(api->get_root(renderer, &root), LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->create_element(renderer, Utf8("view"), &node),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->insert_before(renderer, root, node, 0),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  Element* target = harness.manager_->root()->GetChildAt(0);
+
+  ASSERT_EQ(api->add_event_listener(renderer, node, 7, 11, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  auto event_handler = target->event_map().find("tap");
+  ASSERT_NE(event_handler, target->event_map().end());
+  EXPECT_EQ(event_handler->second->type().str(), "bindEvent");
+  EXPECT_TRUE(event_handler->second->function().empty());
+  auto* listeners = target->GetEventListenerMap()->Find("tap");
+  ASSERT_NE(listeners, nullptr);
+  ASSERT_EQ(listeners->size(), 1u);
+  EXPECT_EQ(listeners->front()->type(),
+            event::EventListener::Type::kNativeEventListener);
+
+  ASSERT_EQ(api->add_event_listener(renderer, node, 8, 12, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(target->event_map().count("tap"), 1u);
+  listeners = target->GetEventListenerMap()->Find("tap");
+  ASSERT_NE(listeners, nullptr);
+  ASSERT_EQ(listeners->size(), 2u);
+  EXPECT_EQ(api->remove_event_listener(renderer, node, 7, 11, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(target->event_map().count("tap"), 1u);
+  listeners = target->GetEventListenerMap()->Find("tap");
+  ASSERT_NE(listeners, nullptr);
+  ASSERT_EQ(listeners->size(), 1u);
+  EXPECT_EQ(listeners->front()->type(),
+            event::EventListener::Type::kNativeEventListener);
+
+  ASSERT_EQ(api->flush(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  event_handler = target->event_map().find("tap");
+  ASSERT_NE(event_handler, target->event_map().end());
+  EXPECT_EQ(event_handler->second->type().str(), "bindEvent");
+  auto event = fml::MakeRefCounted<event::Event>(
+      "tap", event::Event::EventType::kCustomEvent, event::Event::Capture::kNo,
+      event::Event::Bubbles::kNo, event::Event::Cancelable::kNo,
+      event::Event::ComposedMode::kScoped);
+  event::EventDispatcher::DispatchEvent(*target, event);
+  EXPECT_EQ(state.event_count, 1);
+  EXPECT_EQ(state.event_listener, 8u);
+  EXPECT_EQ(state.event_callback, 12u);
+
+  ASSERT_EQ(api->remove_event_listener(renderer, node, 8, 12, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(target->event_map().count("tap"), 0u);
+  listeners = target->GetEventListenerMap()->Find("tap");
+  ASSERT_NE(listeners, nullptr);
+  EXPECT_TRUE(listeners->empty());
+  ASSERT_EQ(api->flush(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(target->event_map().count("tap"), 0u);
+
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
+
 TEST(NativeRendererApiTest, TimerCancellationAndReleaseAreReentrantSafe) {
