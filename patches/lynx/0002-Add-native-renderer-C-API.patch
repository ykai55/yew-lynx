+TEST(NativeRendererApiTest, NegotiatesOnlyV1) {
+  EXPECT_EQ(lynx_native_renderer_get_api(0), nullptr);
+  EXPECT_EQ(lynx_native_renderer_get_api(2), nullptr);
+  const auto* api = lynx_native_renderer_get_api(1);
+  ASSERT_NE(api, nullptr);
+  EXPECT_EQ(api->abi_version, LYNX_NATIVE_RENDERER_ABI_VERSION);
+  EXPECT_EQ(api->struct_size, sizeof(LynxNativeRendererApiV1));
+}
