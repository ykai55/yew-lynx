+LynxNativeUtf8 Utf8(const char* value) {
+  return {reinterpret_cast<const uint8_t*>(value),
+          std::char_traits<char>::length(value)};
+}
+
+struct CallbackState {
+  const LynxNativeRendererApiV1* api{nullptr};
+  int event_count{0};
+  int timer_count{0};
+  bool release_from_event{false};
+  bool release_from_timer{false};
+  LynxNativeRendererStatus release_status{
+      LYNX_NATIVE_RENDERER_STATUS_INTERNAL_ERROR};
+  std::string event_name;
+  std::string content_type;
+  std::string payload;
+};
+
+LynxNativeRendererStatus OnEvent(void* context,
+                                 LynxNativeRendererHandle renderer,
+                                 LynxNativeListenerHandle,
+                                 LynxNativeCallbackHandle, LynxNativeUtf8 name,
+                                 LynxNativeUtf8 content_type,
+                                 LynxNativeBytes payload) {
+  auto* state = static_cast<CallbackState*>(context);
+  ++state->event_count;
+  state->event_name.assign(reinterpret_cast<const char*>(name.data), name.len);
+  state->content_type.assign(reinterpret_cast<const char*>(content_type.data),
+                             content_type.len);
+  state->payload.assign(reinterpret_cast<const char*>(payload.data),
+                        payload.len);
+  if (state->release_from_event) {
+    state->release_status = state->api->release(renderer);
+  }
+  return LYNX_NATIVE_RENDERER_STATUS_OK;
+}
+
+LynxNativeRendererStatus OnTimer(void* context,
+                                 LynxNativeRendererHandle renderer,
+                                 LynxNativeTimerHandle,
+                                 LynxNativeCallbackHandle) {
+  auto* state = static_cast<CallbackState*>(context);
+  ++state->timer_count;
+  if (state->release_from_timer) {
+    state->release_status = state->api->release(renderer);
+  }
+  return LYNX_NATIVE_RENDERER_STATUS_OK;
+}
