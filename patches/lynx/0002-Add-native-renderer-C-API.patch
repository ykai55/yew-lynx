+LynxNativeHostHandle RegisterNativeRendererHost(TemplateAssembler* tasm) {
+#if defined(__cpp_exceptions)
+  try {
+#endif
+    return Hosts().Register(tasm);
+#if defined(__cpp_exceptions)
+  } catch (...) {
+    return 0;
+  }
+#endif
+}
+
+bool UnregisterNativeRendererHost(LynxNativeHostHandle host) {
+#if defined(__cpp_exceptions)
+  try {
+#endif
+    return Hosts().Unregister(host);
+#if defined(__cpp_exceptions)
+  } catch (...) {
+    return false;
+  }
+#endif
