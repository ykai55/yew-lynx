+TEST_P(FiberElementTest, NativeRendererMutatesFiberTreeThroughFunctionTable) {
+  const auto* api = lynx_native_renderer_get_api(1);
+  ASSERT_NE(api, nullptr);
+  CallbackState callback_state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&callback_state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(tasm.get());
+  ASSERT_NE(host, 0u);
+
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_NE(renderer, 0u);
+  LynxNativeNodeHandle root = 0;
+  ASSERT_EQ(api->get_root(renderer, &root), LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_NE(root, 0u);
+
+  LynxNativeNodeHandle first = 0;
+  LynxNativeNodeHandle second = 0;
+  LynxNativeNodeHandle raw_text = 0;
+  ASSERT_EQ(api->create_element(renderer, Utf8("view"), &first),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->create_element(renderer, Utf8("text"), &second),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->create_raw_text(renderer, Utf8("before"), &raw_text),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  EXPECT_EQ(api->set_attribute(renderer, first, Utf8("id"), Utf8("hero")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->set_attribute(renderer, first, Utf8("class"),
+                               Utf8("primary selected")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(
+      api->set_attribute(renderer, first, Utf8("style"), Utf8("width:10px")),
+      LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->set_attribute(renderer, first, Utf8("data-value"), Utf8("42")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->set_raw_text(renderer, raw_text, Utf8("after")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  ASSERT_EQ(api->insert_before(renderer, root, first, 0),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->insert_before(renderer, root, second, first),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->insert_before(renderer, first, raw_text, 0),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(manager->root()->GetChildCount(), 2u);
+  EXPECT_EQ(manager->root()->GetChildAt(0)->GetTag().str(), "text");
+  Element* first_element = manager->root()->GetChildAt(1);
+  EXPECT_EQ(first_element->GetIdSelector().str(), "hero");
+  ASSERT_EQ(first_element->classes().size(), 2u);
+  EXPECT_EQ(first_element->GetRawInlineStyles().str(), "width:10px");
+  EXPECT_EQ(first_element->data_model()
+                ->attributes()
+                .at(base::String("data-value"))
+                .StdString(),
+            "42");
+  auto* raw = static_cast<RawTextElement*>(first_element->GetChildAt(0));
+  EXPECT_EQ(raw->content().str(), "after");
+
+  EXPECT_EQ(api->destroy_node(renderer, first),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_OWNERSHIP);
+  ASSERT_EQ(api->remove_child(renderer, root, first),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(first_element->parent(), nullptr);
+  ASSERT_EQ(api->insert_before(renderer, root, first, 0),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->remove_child(renderer, root, first),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->destroy_node(renderer, first), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->set_raw_text(renderer, raw_text, Utf8("stale")),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_OWNERSHIP);
+
+  EXPECT_EQ(api->flush(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  LynxNativeRendererStatus other_thread_status =
+      LYNX_NATIVE_RENDERER_STATUS_INTERNAL_ERROR;
+  std::thread other_thread([&]() {
+    LynxNativeNodeHandle ignored = 0;
+    other_thread_status = api->get_root(renderer, &ignored);
+  });
+  other_thread.join();
+  EXPECT_EQ(other_thread_status, LYNX_NATIVE_RENDERER_STATUS_WRONG_THREAD);
+
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->release(renderer),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_SESSION);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+  LynxNativeRendererHandle stale_renderer = 0;
+  EXPECT_EQ(api->acquire(host, &callbacks, &stale_renderer),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_SESSION);
+}
