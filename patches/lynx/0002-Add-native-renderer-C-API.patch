+TEST(NativeRendererApiTest, ListenerRemovalUsesExactIdentityAndReleaseDefers) {
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  LynxNativeNodeHandle root = 0;
+  LynxNativeNodeHandle node = 0;
+  ASSERT_EQ(api->get_root(renderer, &root), LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->create_element(renderer, Utf8("view"), &node),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->insert_before(renderer, root, node, 0),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  ASSERT_EQ(api->add_event_listener(renderer, node, 7, 11, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->remove_event_listener(renderer, node, 7, 12, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_LISTENER);
+  Element* target = harness.manager_->root()->GetChildAt(0);
+  auto event = fml::MakeRefCounted<event::Event>(
+      "tap", event::Event::EventType::kCustomEvent, event::Event::Capture::kNo,
+      event::Event::Bubbles::kNo, event::Event::Cancelable::kNo,
+      event::Event::ComposedMode::kScoped);
+  event::EventDispatcher::DispatchEvent(*target, event);
+  EXPECT_EQ(state.event_count, 1);
+  EXPECT_EQ(state.event_name, "tap");
+  EXPECT_EQ(state.content_type, "application/json");
+  EXPECT_FALSE(state.payload.empty());
+
+  ASSERT_EQ(api->remove_event_listener(renderer, node, 7, 11, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  event = fml::MakeRefCounted<event::Event>(
+      "tap", event::Event::EventType::kCustomEvent, event::Event::Capture::kNo,
+      event::Event::Bubbles::kNo, event::Event::Cancelable::kNo,
+      event::Event::ComposedMode::kScoped);
+  event::EventDispatcher::DispatchEvent(*target, event);
+  EXPECT_EQ(state.event_count, 1);
+
+  ASSERT_EQ(api->add_event_listener(renderer, node, 7, 11, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  state.release_from_event = true;
+  event = fml::MakeRefCounted<event::Event>(
+      "tap", event::Event::EventType::kCustomEvent, event::Event::Capture::kNo,
+      event::Event::Bubbles::kNo, event::Event::Cancelable::kNo,
+      event::Event::ComposedMode::kScoped);
+  event::EventDispatcher::DispatchEvent(*target, event);
+  EXPECT_EQ(state.event_count, 2);
+  EXPECT_EQ(state.release_status, LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_FALSE(UnregisterNativeRendererHost(host));
+  harness.loop_.RunExpiredTasksNow();
+  harness.loop_.RunExpiredTasksNow();
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
+
+TEST(NativeRendererApiTest, TimerCancellationAndReleaseAreReentrantSafe) {
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  LynxNativeTimerHandle timer = 0;
+  ASSERT_EQ(api->create_timer(renderer, 0, 0, 21, &timer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_NE(timer, 0u);
+  EXPECT_EQ(api->cancel_timer(renderer, timer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  harness.loop_.RunExpiredTasksNow();
+  EXPECT_EQ(state.timer_count, 0);
+  EXPECT_EQ(api->cancel_timer(renderer, timer),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_OWNERSHIP);
+
+  state.release_from_timer = true;
+  ASSERT_EQ(api->create_timer(renderer, 0, 1, 22, &timer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  harness.loop_.RunExpiredTasksNow();
+  harness.loop_.RunExpiredTasksNow();
+  EXPECT_EQ(state.timer_count, 1);
+  EXPECT_EQ(state.release_status, LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
