     }
   }
+
+  private static void assertUnsupported(Runnable call) {
+    try {
+      call.run();
+      fail("Expected native-renderer-only API to reject runtime or template behavior");
+    } catch (UnsupportedOperationException expected) {
+      // Expected.
+    }
+  }
 }
