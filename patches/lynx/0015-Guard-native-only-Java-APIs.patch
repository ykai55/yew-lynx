@@ -5,6 +5,7 @@
 package com.lynx.tasm;
 
 import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
 import static org.junit.Assert.fail;
 import static org.junit.Assume.assumeTrue;
 
@@ -93,6 +94,40 @@ public class LynxTemplateRenderNativeRendererTest {
     });
   }
 
+  @Test
+  public void nativeRendererOnlyPublicApisDoNotCallOmittedJniMethods() throws Exception {
+    assumeTrue(BuildConfig.enable_native_renderer_only);
+    Context context =
+        InstrumentationRegistry.getInstrumentation().getTargetContext().getApplicationContext();
+    LynxEnv.inst().init((Application) context, System::loadLibrary, null, null, null);
+    assertUnsupported(() -> LynxEnv.inst().getSSRApiVersion());
+
+    Field renderField = LynxView.class.getDeclaredField("mLynxTemplateRender");
+    renderField.setAccessible(true);
+    InstrumentationRegistry.getInstrumentation().runOnMainSync(() -> {
+      LynxView view =
+          new LynxViewBuilder()
+              .setEnableJSRuntime(false)
+              .setThreadStrategyForRendering(ThreadStrategyForRendering.ALL_ON_UI)
+              .build(context);
+      try {
+        LynxTemplateRender render;
+        try {
+          render = (LynxTemplateRender) renderField.get(view);
+        } catch (IllegalAccessException error) {
+          throw new AssertionError(error);
+        }
+        assertTrue(render.shouldSendEventToMainThread());
+        view.setLongTaskMonitorEnabled(LynxBooleanOption.TRUE);
+        assertNotNull(view.getAllTimingInfo());
+        assertUnsupported(view::startLynxRuntime);
+        assertUnsupported(() -> render.getAllJsSource());
+      } finally {
+        view.destroy();
+      }
+    });
+  }
+
