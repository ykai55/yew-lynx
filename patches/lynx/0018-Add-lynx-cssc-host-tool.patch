--- /dev/null
+++ b/tools/lynx-cssc/main.cc
@@ -0,0 +1,149 @@
+// Copyright 2026 The Lynx Authors. All rights reserved.
+// Licensed under the Apache License Version 2.0 that can be found in the
+// LICENSE file in the root directory of this source tree.
+
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include "core/template_bundle/template_codec/binary_encoder/css_encoder/css_parser.h"
+#include "core/template_bundle/template_codec/binary_encoder/template_binary_writer.h"
+#include "core/template_bundle/template_codec/compile_options.h"
+#include "third_party/rapidjson/document.h"
+
+namespace lynx {
+namespace tasm {
+namespace {
+
+class CSSFragmentWriter : public TemplateBinaryWriter {
+ public:
+  CSSFragmentWriter(CSSParser* parser, const CompileOptions& options)
+      : TemplateBinaryWriter(nullptr, runtime::VMContextType, false, nullptr,
+                             parser, nullptr, nullptr, nullptr, nullptr, "", "",
+                             "", "", "", "", {}, options, lepus::Value(),
+                             lepus::Value(), {}, nullptr) {}
+
+  std::vector<uint8_t> Encode(encoder::SharedCSSFragment* fragment) {
+    return EncodeCSSFragmentToVector(fragment);
+  }
+};
+
+int Run(int argc, char** argv) {
+  std::string input_path;
+  std::string output_path;
+  if (argc != 5) {
+    std::cerr << "lynx-cssc: usage: lynx-cssc --input rules.json --output style.lynxcss\n";
+    return 2;
+  }
+  for (int i = 1; i < argc; i += 2) {
+    const std::string option = argv[i];
+    if (option == "--input" && input_path.empty()) {
+      input_path = argv[i + 1];
+    } else if (option == "--output" && output_path.empty()) {
+      output_path = argv[i + 1];
+    } else {
+      std::cerr << "lynx-cssc: invalid arguments\n";
+      return 2;
+    }
+  }
+  if (input_path.empty() || output_path.empty()) {
+    std::cerr << "lynx-cssc: invalid arguments\n";
+    return 2;
+  }
+
+  std::ifstream input(input_path, std::ios::binary);
+  if (!input) {
+    std::cerr << "lynx-cssc: cannot read input\n";
+    return 1;
+  }
+  const std::string json((std::istreambuf_iterator<char>(input)),
+                         std::istreambuf_iterator<char>());
+  if (input.bad()) {
+    std::cerr << "lynx-cssc: cannot read input\n";
+    return 1;
+  }
+
+  rapidjson::Document rules;
+  rules.Parse(json.data(), json.size());
+  if (rules.HasParseError()) {
+    std::cerr << "lynx-cssc: invalid JSON\n";
+    return 1;
+  }
+  if (!rules.IsArray()) {
+    std::cerr << "lynx-cssc: input root must be a ruleList array\n";
+    return 1;
+  }
+  if (rules.Empty()) {
+    std::cerr << "lynx-cssc: ruleList must not be empty\n";
+    return 1;
+  }
+  for (const auto& rule : rules.GetArray()) {
+    if (!rule.IsObject() || !rule.HasMember("type") ||
+        !rule["type"].IsString() ||
+        std::string(rule["type"].GetString()) != "StyleRule" ||
+        !rule.HasMember("selectorText") ||
+        !rule["selectorText"].IsObject() ||
+        !rule["selectorText"].HasMember("value") ||
+        !rule["selectorText"]["value"].IsString() ||
+        !rule.HasMember("style") || !rule["style"].IsArray() ||
+        !rule.HasMember("variables") || !rule["variables"].IsObject()) {
+      std::cerr << "lynx-cssc: unsupported or invalid ruleList\n";
+      return 1;
+    }
+    for (const auto& declaration : rule["style"].GetArray()) {
+      if (!declaration.IsObject() || !declaration.HasMember("name") ||
+          !declaration["name"].IsString() ||
+          !declaration.HasMember("value") ||
+          !declaration["value"].IsString() ||
+          (declaration.HasMember("type") &&
+           !declaration["type"].IsString()) ||
+          (declaration.HasMember("defaultValue") &&
+           !declaration["defaultValue"].IsString())) {
+        std::cerr << "lynx-cssc: unsupported or invalid ruleList\n";
+        return 1;
+      }
+    }
+    for (auto variable = rule["variables"].MemberBegin();
+         variable != rule["variables"].MemberEnd(); ++variable) {
+      if (!variable->value.IsString()) {
+        std::cerr << "lynx-cssc: unsupported or invalid ruleList\n";
+        return 1;
+      }
+    }
+  }
+
+  CompileOptions options = CreateNativeCSSCompileOptions();
+  CSSParser parser(options);
+  auto fragment = parser.ParseExternalFragment(rules, input_path);
+  if (fragment == nullptr || !parser.css_diagnostics().empty()) {
+    std::cerr << "lynx-cssc: CSS ruleList parse failed\n";
+    return 1;
+  }
+  CSSFragmentWriter writer(&parser, options);
+  std::vector<uint8_t> payload = writer.Encode(fragment.get());
+  if (payload.empty()) {
+    std::cerr << "lynx-cssc: CSS fragment encode failed\n";
+    return 1;
+  }
+
+  std::ofstream output(output_path, std::ios::binary | std::ios::trunc);
+  if (!output) {
+    std::cerr << "lynx-cssc: cannot write output\n";
+    return 1;
+  }
+  output.write(reinterpret_cast<const char*>(payload.data()), payload.size());
+  output.close();
+  if (!output) {
+    std::cerr << "lynx-cssc: cannot write output\n";
+    return 1;
+  }
+  return 0;
+}
+
+}  // namespace
+}  // namespace tasm
+}  // namespace lynx
+
+int main(int argc, char** argv) { return lynx::tasm::Run(argc, argv); }
