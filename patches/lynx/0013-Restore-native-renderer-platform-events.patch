 public class LynxTemplateRenderNativeRendererTest {
   @Test
   public void nativeRendererRegistrationRejectsIncompatibleRuntimeState() {
@@ -52,6 +62,37 @@ public class LynxTemplateRenderNativeRendererTest {
     assertNativeRendererOnlyConfigurationRejected(false, false, false, true);
   }
 
+  @Test
+  public void nativeRendererOnlyInitializesPlatformEventPlumbing() throws Exception {
+    assumeTrue(BuildConfig.enable_native_renderer_only);
+    Context context =
+        InstrumentationRegistry.getInstrumentation().getTargetContext().getApplicationContext();
+    LynxEnv.inst().init((Application) context, System::loadLibrary, null, null, null);
+    Field proxyField =
+        LynxEventEmitter.LynxEngineProxyWrapper.class.getDeclaredField("mEngineProxy");
+    proxyField.setAccessible(true);
+
+    InstrumentationRegistry.getInstrumentation().runOnMainSync(() -> {
+      LynxView view =
+          new LynxViewBuilder()
+              .setEnableJSRuntime(false)
+              .setThreadStrategyForRendering(ThreadStrategyForRendering.ALL_ON_UI)
+              .build(context);
+      try {
+        assertNotNull(view.getLynxContext());
+        assertNotNull(view.getLynxContext().getEventEmitter());
+        LynxEventEmitter eventEmitter = (LynxEventEmitter) view.getLynxContext().getEventEmitter();
+        try {
+          assertNotNull(proxyField.get(eventEmitter.mEngineProxy));
+        } catch (IllegalAccessException error) {
+          throw new AssertionError(error);
+        }
+      } finally {
+        view.destroy();
+      }
+    });
+  }
+
   private static void assertNativeRendererOnlyConfigurationRejected(boolean enableJSRuntime,
       boolean hasBackgroundRuntime, boolean hasViewGroup, boolean hasLogicExecutor) {
     try {
