Date: Sat, 22 Aug 2026 11:00:00 +0800
Subject: [PATCH 13/13] Restore native renderer platform events

Native-renderer-only views still need the platform EventEmitter and engine
proxy to forward Android touch events into TASM. Keep the layout proxy and
runtime-only initialization disabled, but restore this renderer-owned event
path and cover both its Java setup and native tap registration.
---
 core/renderer/native_renderer_unittest.cc     | 12 +++++-
 .../LynxTemplateRenderNativeRendererTest.java | 41 +++++++++++++++++++
 .../java/com/lynx/tasm/LynxTemplateRender.java | 17 ++++----
 3 files changed, 62 insertions(+), 8 deletions(-)

diff --git a/core/renderer/native_renderer_unittest.cc b/core/renderer/native_renderer_unittest.cc
index 52affcd..9f9c7d2 100644
--- a/core/renderer/native_renderer_unittest.cc
+++ b/core/renderer/native_renderer_unittest.cc
@@ -535,7 +535,17 @@ TEST(NativeRendererApiTest,
             LYNX_NATIVE_RENDERER_STATUS_OK);
   ASSERT_EQ(api->flush(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
 
-  Element* target = harness.manager_->root()->GetChildAt(0)->GetChildAt(0);
+  Element* listener_target = harness.manager_->root()->GetChildAt(0);
+  auto event_handler = listener_target->event_map().find("tap");
+  ASSERT_NE(event_handler, listener_target->event_map().end());
+  EXPECT_EQ(event_handler->second->type().str(), "bindEvent");
+  auto* listeners = listener_target->GetEventListenerMap()->Find("tap");
+  ASSERT_NE(listeners, nullptr);
+  ASSERT_EQ(listeners->size(), 1u);
+  EXPECT_EQ(listeners->front()->type(),
+            event::EventListener::Type::kNativeEventListener);
+
+  Element* target = listener_target->GetChildAt(0);
   harness.tasm_->SendTouchEvent(
       "tap", EventInfo(target->impl_id(), 0, 0, 0, 0, 0, 0));
   EXPECT_EQ(state.event_count, 1);
diff --git a/platform/android/lynx_android/src/android_test/java/com/lynx/tasm/LynxTemplateRenderNativeRendererTest.java b/platform/android/lynx_android/src/android_test/java/com/lynx/tasm/LynxTemplateRenderNativeRendererTest.java
