+NativeRendererDiagnostics LynxShell::GetNativeRendererDiagnostics() {
+  NativeRendererDiagnostics diagnostics;
+  diagnostics.bts_runtime = GetRuntimeActor() != nullptr;
+  tasm::TemplateAssembler* assembler = GetTasm();
+  if (assembler == nullptr) {
+    return diagnostics;
+  }
+  std::shared_ptr<tasm::TemplateEntry> entry =
+      assembler->FindTemplateEntry(tasm::DEFAULT_ENTRY_NAME);
+  diagnostics.mts_context = entry != nullptr && entry->GetVm() != nullptr;
+  diagnostics.template_bundle =
+      entry != nullptr && entry->GetCompleteTemplateBundle() != nullptr;
+  return diagnostics;
+}
+
+bool LynxShell::CanRegisterNativeRendererHost() {
+  const NativeRendererDiagnostics diagnostics =
+      GetNativeRendererDiagnostics();
+  return !diagnostics.bts_runtime && !diagnostics.mts_context &&
+         !diagnostics.template_bundle;
+}
