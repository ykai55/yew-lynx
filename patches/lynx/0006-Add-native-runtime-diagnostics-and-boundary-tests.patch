   std::shared_ptr<fml::AutoResetWaitableEvent> arwe_;
 };
 
+TEST_F(LynxShellTest, NativeRendererRegistrationRejectsRuntimeOrTemplateState) {
+  NativeRendererDiagnostics diagnostics =
+      shell_->GetNativeRendererDiagnostics();
+  EXPECT_TRUE(diagnostics.bts_runtime);
+  EXPECT_FALSE(diagnostics.mts_context);
+  EXPECT_FALSE(diagnostics.template_bundle);
+  EXPECT_FALSE(shell_->CanRegisterNativeRendererHost());
+
+  shell_->runtime_actor_.reset();
+  diagnostics = shell_->GetNativeRendererDiagnostics();
+  EXPECT_FALSE(diagnostics.bts_runtime);
+  EXPECT_FALSE(diagnostics.mts_context);
+  EXPECT_FALSE(diagnostics.template_bundle);
+  EXPECT_TRUE(shell_->CanRegisterNativeRendererHost());
+
+  auto entry =
+      shell_->GetTasm()->FindTemplateEntry(tasm::DEFAULT_ENTRY_NAME);
+  ASSERT_NE(entry, nullptr);
+  entry->is_template_bundle_complete_ = true;
+  diagnostics = shell_->GetNativeRendererDiagnostics();
+  EXPECT_FALSE(diagnostics.bts_runtime);
+  EXPECT_FALSE(diagnostics.mts_context);
+  EXPECT_TRUE(diagnostics.template_bundle);
+  EXPECT_FALSE(shell_->CanRegisterNativeRendererHost());
+}
