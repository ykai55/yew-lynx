Subject: [PATCH 6/6] Add native runtime diagnostics and boundary tests

Reject Android native host registration when BTS, template, or MTS state is
present. Cover the production function-table rejection boundary and expose
stable runtime-native diagnostics to the Android host.

---
diff --git a/core/renderer/native_renderer_unittest.cc b/core/renderer/native_renderer_unittest.cc
index a3bf3db5209ec53a6d09d405c0a751212819ecae..2de51360d40b4e205cc4a4ead87fbe0f991576a6 100644
--- a/core/renderer/native_renderer_unittest.cc
+++ b/core/renderer/native_renderer_unittest.cc
@@ -129,6 +129,144 @@ TEST(NativeRendererApiTest, NegotiatesOnlyV1) {
   EXPECT_EQ(api->struct_size, sizeof(LynxNativeRendererApiV1));
 }
 
+TEST(NativeRendererApiTest, RejectsNullCallbacksAndOutputsWithoutMutation) {
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  ASSERT_NE(api, nullptr);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+
+  LynxNativeRendererHandle renderer = 41;
+  EXPECT_EQ(api->acquire(host, nullptr, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(renderer, 41u);
+  EXPECT_EQ(api->acquire(host, &callbacks, nullptr),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(harness.manager_->root(), nullptr);
+
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_NE(renderer, 0u);
+  EXPECT_EQ(api->get_root(renderer, nullptr),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(api->create_element(renderer, Utf8("view"), nullptr),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(api->create_raw_text(renderer, Utf8("text"), nullptr),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(api->create_timer(renderer, 0, 0, 1, nullptr),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  ASSERT_NE(harness.manager_->root(), nullptr);
+  EXPECT_EQ(harness.manager_->root()->GetChildCount(), 0u);
+
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
+
+TEST(NativeRendererApiTest, RejectsInvalidUtf8AndNullNonEmptySpans) {
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  ASSERT_NE(api, nullptr);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  const uint8_t invalid_utf8[] = {0xc0, 0xaf};
+  LynxNativeNodeHandle rejected_node = 73;
+  EXPECT_EQ(api->create_element(renderer, {invalid_utf8, 2}, &rejected_node),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(rejected_node, 0u);
+  rejected_node = 73;
+  EXPECT_EQ(api->create_element(renderer, {nullptr, 1}, &rejected_node),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  EXPECT_EQ(rejected_node, 0u);
+  EXPECT_EQ(harness.manager_->root()->GetChildCount(), 0u);
+
+  LynxNativeNodeHandle node = 0;
+  ASSERT_EQ(api->create_element(renderer, Utf8("view"), &node),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->set_attribute(renderer, node, Utf8("id"), Utf8("before")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->set_attribute(renderer, node, Utf8("id"),
+                               {invalid_utf8, 2}),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_ARGUMENT);
+  ASSERT_EQ(harness.manager_->root()->GetChildCount(), 0u);
+  LynxNativeNodeHandle root = 0;
+  ASSERT_EQ(api->get_root(renderer, &root), LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->insert_before(renderer, root, node, 0),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  Element* element = harness.manager_->root()->GetChildAt(0);
+  EXPECT_EQ(element->GetIdSelector().str(), "before");
+
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
+
+TEST(NativeRendererApiTest, RejectedHandlesHaveNoSideEffects) {
+  NativeRendererHarness first_harness;
+  NativeRendererHarness second_harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  ASSERT_NE(api, nullptr);
+  CallbackState first_state{api};
+  CallbackState second_state{api};
+  LynxNativeRendererCallbacksV1 first_callbacks{&first_state, &OnEvent,
+                                                 &OnTimer};
+  LynxNativeRendererCallbacksV1 second_callbacks{&second_state, &OnEvent,
+                                                  &OnTimer};
+  LynxNativeHostHandle first_host =
+      RegisterNativeRendererHost(first_harness.tasm_.get());
+  LynxNativeHostHandle second_host =
+      RegisterNativeRendererHost(second_harness.tasm_.get());
+  ASSERT_NE(first_host, 0u);
+  ASSERT_NE(second_host, 0u);
+  LynxNativeRendererHandle first_renderer = 0;
+  LynxNativeRendererHandle second_renderer = 0;
+  ASSERT_EQ(api->acquire(first_host, &first_callbacks, &first_renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->acquire(second_host, &second_callbacks, &second_renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  LynxNativeNodeHandle first_root = 0;
+  ASSERT_EQ(api->get_root(first_renderer, &first_root),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  ASSERT_EQ(api->set_attribute(first_renderer, first_root, Utf8("id"),
+                               Utf8("owner")),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->set_attribute(second_renderer, first_root, Utf8("id"),
+                               Utf8("foreign")),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_OWNERSHIP);
+  EXPECT_EQ(first_harness.manager_->root()->GetIdSelector().str(), "owner");
+  EXPECT_TRUE(second_harness.manager_->root()->GetIdSelector().str().empty());
+
+  LynxNativeNodeHandle wrong_thread_output = 91;
+  LynxNativeRendererStatus wrong_thread_status =
+      LYNX_NATIVE_RENDERER_STATUS_INTERNAL_ERROR;
+  std::thread other_thread([&]() {
+    wrong_thread_status =
+        api->create_element(first_renderer, Utf8("view"), &wrong_thread_output);
+  });
+  other_thread.join();
+  EXPECT_EQ(wrong_thread_status, LYNX_NATIVE_RENDERER_STATUS_WRONG_THREAD);
+  EXPECT_EQ(wrong_thread_output, 91u);
+  EXPECT_EQ(first_harness.manager_->root()->GetChildCount(), 0u);
+
+  EXPECT_EQ(api->release(first_renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  LynxNativeNodeHandle stale_output = 92;
+  EXPECT_EQ(api->create_element(first_renderer, Utf8("view"), &stale_output),
+            LYNX_NATIVE_RENDERER_STATUS_INVALID_SESSION);
+  EXPECT_EQ(stale_output, 92u);
+  EXPECT_EQ(first_harness.manager_->root(), nullptr);
+
+  EXPECT_EQ(api->release(second_renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(first_host));
+  EXPECT_TRUE(UnregisterNativeRendererHost(second_host));
+}
