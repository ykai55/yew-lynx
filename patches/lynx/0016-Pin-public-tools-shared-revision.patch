Subject: [PATCH 16/16] Pin public tools shared revision

The previously referenced tools-shared commit is not available from the public
GitHub repository. Pin its public parent in Habitat's primary dependencies file;
the omitted child only changes an iOS packaging helper and is unrelated to the
Android native renderer build.
---
 dependencies/DEPS | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dependencies/DEPS b/dependencies/DEPS
--- a/dependencies/DEPS
+++ b/dependencies/DEPS
@@ -376,7 +376,7 @@ deps = {
     "./tools_shared": {
         "type": "git",
         "url": "https://github.com/lynx-family/tools-shared.git",
-        "commit": "bdea62f7b500026aab237b271abc7eff279a5c2d",
+        "commit": "ff47fee7d41ee3e8e8561041b1ce2c8b50e923ea",
         "ignore_in_git": True,
     },
     'buildtools/doxygen': {
