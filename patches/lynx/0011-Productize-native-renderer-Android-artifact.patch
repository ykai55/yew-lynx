+  static void requireNativeRendererOnlyConfiguration(LynxViewBuilder builder) {
+    if (!BuildConfig.enable_native_renderer_only) {
+      return;
+    }
+    requireNativeRendererOnlyConfiguration(builder.isEnableJSRuntime(),
+        builder.lynxBackgroundRuntime != null, builder.lynxViewGroup != null,
+        builder.getLogicExecutor() != null);
+  }
+
+  static void requireNativeRendererOnlyConfiguration(boolean enableJSRuntime,
+      boolean hasBackgroundRuntime, boolean hasViewGroup, boolean hasLogicExecutor) {
+    if (enableJSRuntime) {
+      throw new UnsupportedOperationException(
+          "JavaScript runtimes are unavailable in native-renderer-only builds");
+    }
+    if (hasBackgroundRuntime || hasLogicExecutor) {
+      throw new UnsupportedOperationException(
+          "Background runtimes are unavailable in native-renderer-only builds");
+    }
+    if (hasViewGroup) {
+      throw new UnsupportedOperationException(
+          "Template bundles and engine cache/reuse are unavailable in native-renderer-only builds");
+    }
+  }
