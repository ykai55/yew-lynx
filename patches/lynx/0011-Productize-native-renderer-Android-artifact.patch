         buildConfigField("Boolean","enable_lepusng_worklet",enable_lepusng_worklet)
         buildConfigField("Boolean","enable_napi_binding",enable_napi_binding)
         buildConfigField("Boolean","enable_native_renderer_only",enable_native_renderer_only)
+        buildConfigField("String", "LYNX_NATIVE_LIBRARY_NAME",
+                enable_native_renderer_only.toBoolean() ? '"lynx_native_renderer"' : '"lynx"')
 
         multiDexEnabled true
 
@@ -180,6 +182,8 @@ android {
        cmake {
            path "CMakeLists.txt"
            version CMAKE_VERSION
+           buildStagingDirectory file(".cxx/" +
+                   (enable_native_renderer_only.toBoolean() ? "native-renderer" : "stock"))
        }
    }
 
@@ -347,6 +351,8 @@ dependencies {
         extractJNI 'org.lynxsdk.lynx:v8so:11.1.277.4'
     }
 
-    api project(':LynxJSSDK')
+    if (!enable_native_renderer_only.toBoolean()) {
+        api project(':LynxJSSDK')
+    }
     api project(':ServiceAPI')
 }
diff --git a/platform/android/lynx_android/src/android_test/java/com/lynx/tasm/LynxTemplateRenderNativeRendererTest.java b/platform/android/lynx_android/src/android_test/java/com/lynx/tasm/LynxTemplateRenderNativeRendererTest.java
index cc08e1c..c6dd4d9 100644
--- a/platform/android/lynx_android/src/android_test/java/com/lynx/tasm/LynxTemplateRenderNativeRendererTest.java
+++ b/platform/android/lynx_android/src/android_test/java/com/lynx/tasm/LynxTemplateRenderNativeRendererTest.java
@@ -38,4 +38,28 @@ public class LynxTemplateRenderNativeRendererTest {
   public void engineRebuildAllowsMissingNativeRendererHost() {
     LynxTemplateRender.checkNativeRendererHostForEngineRebuild(0);
   }
+
+  @Test
+  public void nativeRendererOnlyConfigurationAcceptsRendererOnlyBuilder() {
+    LynxTemplateRender.requireNativeRendererOnlyConfiguration(false, false, false, false);
+  }
+
+  @Test
+  public void nativeRendererOnlyConfigurationRejectsRuntimeAndEngineProducts() {
+    assertNativeRendererOnlyConfigurationRejected(true, false, false, false);
+    assertNativeRendererOnlyConfigurationRejected(false, true, false, false);
+    assertNativeRendererOnlyConfigurationRejected(false, false, true, false);
+    assertNativeRendererOnlyConfigurationRejected(false, false, false, true);
+  }
+
+  private static void assertNativeRendererOnlyConfigurationRejected(boolean enableJSRuntime,
+      boolean hasBackgroundRuntime, boolean hasViewGroup, boolean hasLogicExecutor) {
+    try {
+      LynxTemplateRender.requireNativeRendererOnlyConfiguration(
+          enableJSRuntime, hasBackgroundRuntime, hasViewGroup, hasLogicExecutor);
+      fail("Expected native-renderer-only configuration to reject runtime or engine state");
+    } catch (UnsupportedOperationException expected) {
+      // Expected.
+    }
+  }
 }
