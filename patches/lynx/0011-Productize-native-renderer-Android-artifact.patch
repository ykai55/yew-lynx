From: ykai55 <ykai55@users.noreply.github.com>
Date: Sat, 22 Aug 2026 08:15:00 +0800
Subject: [PATCH 11/11] Productize native renderer Android artifact

Give the native-renderer-only product a distinct soname and runtime
boundary while preserving the stock Android artifact.
---
 .../android/lynx_template_render_android.cc   |  2 +-
 platform/android/lynx_android/BUILD.gn        |  6 ++-
 platform/android/lynx_android/build.gradle    |  8 +++-
 .../LynxTemplateRenderNativeRendererTest.java | 24 ++++++++++++
 .../com/lynx/tasm/LynxBackgroundRuntime.java  |  5 +++
 .../main/java/com/lynx/tasm/LynxEngine.java   |  5 +++
 .../src/main/java/com/lynx/tasm/LynxEnv.java  |  2 +-
 .../com/lynx/tasm/LynxTemplateRender.java     | 38 +++++++++++++++++--
 .../src/main/java/com/lynx/tasm/LynxView.java |  1 +
 .../java/com/lynx/tasm/TemplateBundle.java    |  5 +++
 .../main/java/com/lynx/tasm/core/JSProxy.java |  9 +++++
 .../lynx_android/src/main/jni/jni_configs.yml |  2 +
 12 files changed, 99 insertions(+), 8 deletions(-)

diff --git a/core/shell/android/lynx_template_render_android.cc b/core/shell/android/lynx_template_render_android.cc
index e1f4e61..c814b25 100644
--- a/core/shell/android/lynx_template_render_android.cc
+++ b/core/shell/android/lynx_template_render_android.cc
@@ -299,7 +299,7 @@ jlong Create(JNIEnv* env, jclass jcaller, jlong view_id,
              jlong engine_wrapper_ptr, jobject module_factory) {
 #if ENABLE_NATIVE_RENDERER_ONLY
   if (enable_js || runtime_wrapper_ptr != 0 || engine_wrapper_ptr != 0 ||
-      module_factory != nullptr) {
+      module_factory != nullptr || has_logic_executor || embedded_mode != 0) {
     return 0;
   }
 #endif
diff --git a/platform/android/lynx_android/BUILD.gn b/platform/android/lynx_android/BUILD.gn
