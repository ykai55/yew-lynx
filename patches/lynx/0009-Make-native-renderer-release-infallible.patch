+class NativeRendererTestPeer {
+ public:
+  static bool HasPreparedReleaseOptions(
+      LynxNativeRendererHandle renderer) noexcept;
+};
+
 namespace {
 
 using Status = LynxNativeRendererStatus;
@@ -459,6 +466,8 @@ class Session final : public std::enable_shared_from_this<Session> {
       return kHostError;
     }
 
+    release_options_ = std::make_shared<PipelineOptions>();
+    release_options_->pipeline_origin = "native_renderer_release";
     previous_page_config_ = tasm_->GetPageConfig();
     auto config = std::make_shared<PageConfig>();
     config->SetEnableFiberArch(true);
@@ -489,11 +498,11 @@ class Session final : public std::enable_shared_from_this<Session> {
 
   LynxNativeRendererHandle renderer_handle() const { return renderer_; }
 
-  bool CanReleaseSynchronously() const {
+  bool CanReleaseSynchronously() const noexcept {
     return CheckThread() == kOk && active_ && dispatch_depth_ == 0;
   }
 
-  Status CheckThread() const {
+  Status CheckThread() const noexcept {
     return owner_ == std::this_thread::get_id() ? kOk : kWrongThread;
   }
 
@@ -893,7 +902,7 @@ class Session final : public std::enable_shared_from_this<Session> {
     return kOk;
   }
 
-  Status PrepareRelease() {
+  Status PrepareRelease() const noexcept {
     Status status = CheckThread();
     if (status != kOk) {
       return status;
@@ -901,11 +910,6 @@ class Session final : public std::enable_shared_from_this<Session> {
     if (!active_) {
       return kInvalidSession;
     }
-
-    if (release_options_ == nullptr) {
-      release_options_ = std::make_shared<PipelineOptions>();
-      release_options_->pipeline_origin = "native_renderer_release";
-    }
     return kOk;
   }
 
@@ -1241,6 +1245,8 @@ class Session final : public std::enable_shared_from_this<Session> {
   bool template_lifecycle_started_{false};
   bool cleanup_scheduled_{false};
   bool finalized_{false};
+
+  friend class ::lynx::tasm::NativeRendererTestPeer;
 };
 
 void NativeEventListener::Invoke(fml::RefPtr<event::Event> event) noexcept {
@@ -1463,6 +1469,12 @@ const LynxNativeRendererApiV1 kApiV1 = {
 
 }  // namespace
 
+bool NativeRendererTestPeer::HasPreparedReleaseOptions(
+    LynxNativeRendererHandle renderer) noexcept {
+  std::shared_ptr<Session> session = FindSession(renderer);
+  return session != nullptr && session->release_options_ != nullptr;
+}
