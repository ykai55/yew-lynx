Subject: [PATCH 14/15] Cover native renderer callback statuses

Exercise unsupported callbacks, task-runner exceptions, and callback-returned
resource exhaustion and internal errors through the production function table.
Verify that each non-OK timer callback status cancels a repeating timer without
adding allocator hooks or private fault injection.
---
 core/renderer/native_renderer_unittest.cc | 90 +++++++++++++++++++++++
 1 file changed, 90 insertions(+)

diff --git a/core/renderer/native_renderer_unittest.cc b/core/renderer/native_renderer_unittest.cc
index 9f9c7d2..22d1e34 100644
--- a/core/renderer/native_renderer_unittest.cc
+++ b/core/renderer/native_renderer_unittest.cc
@@ -98,9 +98,16 @@ class RunnerTasmDelegate : public test::MockTasmDelegate {
       : runner_(std::move(runner)) {}
 
   fml::RefPtr<fml::TaskRunner> GetLepusTimedTaskRunner() override {
+#if defined(__cpp_exceptions)
+    if (throw_on_get_task_runner_) {
+      throw std::runtime_error("task runner unavailable");
+    }
+#endif
     return runner_;
   }
 
+  bool throw_on_get_task_runner_{false};
+
  private:
   fml::RefPtr<fml::TaskRunner> runner_;
 };
@@ -176,6 +183,32 @@ TEST(NativeRendererApiTest, RejectsNullCallbacksAndOutputsWithoutMutation) {
   EXPECT_TRUE(UnregisterNativeRendererHost(host));
 }
 
+TEST(NativeRendererApiTest, MissingCallbacksReturnUnsupported) {
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  ASSERT_NE(api, nullptr);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, nullptr, nullptr};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  LynxNativeNodeHandle root = 0;
+  ASSERT_EQ(api->get_root(renderer, &root), LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  EXPECT_EQ(api->add_event_listener(renderer, root, 1, 1, Utf8("tap")),
+            LYNX_NATIVE_RENDERER_STATUS_UNSUPPORTED);
+  EXPECT_TRUE(harness.manager_->root()->event_map().empty());
+  LynxNativeTimerHandle timer = 73;
+  EXPECT_EQ(api->create_timer(renderer, 0, 0, 1, &timer),
+            LYNX_NATIVE_RENDERER_STATUS_UNSUPPORTED);
+  EXPECT_EQ(timer, 0u);
+
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
+
 TEST(NativeRendererApiTest, RejectsInvalidUtf8AndNullNonEmptySpans) {
   NativeRendererHarness harness;
   const auto* api = lynx_native_renderer_get_api(1);
@@ -834,6 +867,63 @@ TEST(NativeRendererApiTest, RepeatingTimerStopsAfterCallbackFailure) {
