 }
 
+TEST(NativeRendererApiTest,
+     RepeatingTimersStopForResourceAndInternalCallbackFailures) {
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+  LynxNativeRendererHandle renderer = 0;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+
+  for (LynxNativeRendererStatus status :
+       {LYNX_NATIVE_RENDERER_STATUS_RESOURCE_EXHAUSTED,
+        LYNX_NATIVE_RENDERER_STATUS_INTERNAL_ERROR}) {
+    state.timer_status = status;
+    const int previous_count = state.timer_count;
+    LynxNativeTimerHandle timer = 0;
+    ASSERT_EQ(api->create_timer(renderer, 0, 1, 32, &timer),
+              LYNX_NATIVE_RENDERER_STATUS_OK);
+    harness.loop_.RunExpiredTasksNow();
+    harness.loop_.RunExpiredTasksNow();
+    EXPECT_EQ(state.timer_count, previous_count + 1);
+    EXPECT_EQ(api->cancel_timer(renderer, timer),
+              LYNX_NATIVE_RENDERER_STATUS_INVALID_OWNERSHIP);
+  }
+
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+}
+
+TEST(NativeRendererApiTest, HostExceptionReturnsPanicAndRollsBackAcquire) {
+#if defined(__cpp_exceptions)
+  NativeRendererHarness harness;
+  const auto* api = lynx_native_renderer_get_api(1);
+  CallbackState state{api};
+  LynxNativeRendererCallbacksV1 callbacks{&state, &OnEvent, &OnTimer};
+  auto original_config = harness.tasm_->GetPageConfig();
+  LynxNativeHostHandle host = RegisterNativeRendererHost(harness.tasm_.get());
+  ASSERT_NE(host, 0u);
+
+  harness.delegate_.throw_on_get_task_runner_ = true;
+  LynxNativeRendererHandle renderer = 73;
+  EXPECT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_PANIC);
+  EXPECT_EQ(renderer, 0u);
+  EXPECT_EQ(harness.manager_->root(), nullptr);
+  EXPECT_EQ(harness.tasm_->GetPageConfig(), original_config);
+
+  harness.delegate_.throw_on_get_task_runner_ = false;
+  ASSERT_EQ(api->acquire(host, &callbacks, &renderer),
+            LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_EQ(api->release(renderer), LYNX_NATIVE_RENDERER_STATUS_OK);
+  EXPECT_TRUE(UnregisterNativeRendererHost(host));
+#endif
+}
